+"""Cross-tray NCCL check: run one rank on each of two trays and report the transport NCCL picks + bandwidth.
+
+# on tray A (rank 0) and tray B (rank 1), same MASTER_ADDR:
+MASTER_ADDR=<trayA> MASTER_PORT=29999 RANK=0 WORLD_SIZE=2 CUDA_VISIBLE_DEVICES=0 NCCL_DEBUG=INFO python serve/nccl_xtray_test.py
+"""
+
+import os
+import time
+
+import torch
+import torch.distributed as dist
+
+dist.init_process_group("nccl")
+rank = dist.get_rank()
+torch.cuda.set_device(0)
+x = torch.ones(256 << 20, dtype=torch.uint8, device="cuda")  # 256 MiB
+for _ in range(3):
+    dist.all_reduce(x)
+torch.cuda.synchronize()
+t0 = time.perf_counter()
+n = 10
+for _ in range(n):
+    dist.all_reduce(x)
+torch.cuda.synchronize()
+dt = (time.perf_counter() - t0) / n
+print(
+    f"rank {rank} on {os.uname().nodename}: all_reduce 256 MiB avg {dt * 1e3:.2f} ms -> {x.numel() / dt / 2**30:.1f} GiB/s algbw",
+    flush=True,
+)
+dist.destroy_process_group()
diff --git a/serve/openai_server.py b/serve/openai_server.py
new file mode 100644
index 0000000..1e41bf2
--- /dev/null
+++ b/serve/openai_server.py
@@ -0,0 +1,522 @@
+"""Minimal OpenAI-compatible chat server on top of the DeepInfer offline engine.
+
+DeepInfer ships offline inference only. This wraps one `LLM` per data-parallel rank
+(attention DP + MoE EP, same layout as examples/benchmark.py) behind a FastAPI frontend
+so request-replay benchmarks such as InferenceX AgentX (aiperf) can drive it.
+
+    python serve/openai_server.py --model ~/models/DeepSeek-V4.1-Flash-1017 --dp 4 --port 8888
+
+Limitations, by design of the open-source engine:
+- No cross-request prefix cache: every request prefills its full prompt.
+- Responses are streamed as plain `content`; DSML tool calls are not parsed into `tool_calls`.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import collections
+import hashlib
+import json
+import multiprocessing as mp
+import os
+import queue
+import sys
+import threading
+import time
+import uuid
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+# Module level so FastAPI can resolve the string annotation `request: Request`.
+from fastapi import FastAPI, Request
+
+if TYPE_CHECKING:
+    from deepinfer._C.engine import Sequence
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO_ROOT / "examples"))
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", required=True, help="local HF checkpoint directory")
+    p.add_argument("--served-model-name", default=None)
+    p.add_argument("--dp", type=int, default=4, help="data-parallel ranks on this node (= EP size)")
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8888)
+    p.add_argument("--max-model-len", type=int, default=1 << 20)
+    p.add_argument("--max-num-seqs", type=int, default=128, help="per DP rank")
+    p.add_argument("--max-num-batched-tokens", type=int, default=32768, help="prefill chunk per DP rank")
+    p.add_argument("--gpu-memory-utilization", type=float, default=0.9)
+    p.add_argument("--yoco-keep-tokens", type=int, default=140, help="0 disables decoder SWA bounded replay")
+    p.add_argument("--thinking-mode", default="chat", choices=["chat", "thinking"])
+    p.add_argument("--log-interval-steps", type=int, default=200)
+    p.add_argument("--hicache-size-gb", type=float, default=32, help="pinned host KV page pool per DP rank; 0 disables the prefix cache")
+    p.add_argument("--hicache-state-slots", type=int, default=4096, help="host SWA state slots per DP rank")
+    p.add_argument(
+        "--routing",
+        default="affinity",
+        choices=["affinity", "least-loaded"],
+        help="affinity: a conversation's turns go to one rank (needed for cache hits)",
+    )
+    p.add_argument(
+        "--prefill-any-interval",
+        type=int,
+        default=2,
+        help="DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL: a rank with a waiting prompt gets a prefill step at most this "
+        "many decode steps later even if other ranks are idle (engine default 100 => ~1.4 s TTFT floor)",
+    )
+    return p.parse_args()
+
+
+# --------------------------------------------------------------------------- engine side
+
+
+def worker_main(args: argparse.Namespace, dp_rank: int, in_q: mp.Queue, out_q: mp.Queue) -> None:
+    """One DP rank: owns an engine and steps it in lockstep with the other ranks."""
+    import ctypes
+    import signal
+
+    # Die with the frontend instead of lingering as an orphan that holds the GPU.
+    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
+
+    from _config import create_llm, setup_common_env
+
+    if args.yoco_keep_tokens > 0:
+        os.environ["DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE"] = "compact"
+        os.environ["DEEPINFER_YOCO_PREFILL_KEEP_TOKENS"] = str(args.yoco_keep_tokens)
+        os.environ["DEEPINFER_PREFILL_STORE_EXTRA_STATE"] = "1"
+    if args.hicache_size_gb > 0:
+        # Keep more SWA history in the state ring so the prefix cache can store states at several
+        # 128-boundaries behind the end of a prompt (see HostPrefixCache.state_lookback_blocks).
+        os.environ.setdefault("DEEPINFER_PREFILL_STORE_EXTRA_SIZE", "512")
+    os.environ.setdefault("DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL", str(args.prefill_any_interval))
+    setup_common_env(model_name=args.model, sampler_force_topk=1024, set_override_experts=True, enable_eplb=True)
+
+    llm = create_llm(
+        args.model,
+        dp_rank,
+        ep_size=args.dp,
+        env={"DEEPINFER_LOGGING_INTERVAL_STEP": str(args.log_interval_steps)},
+        data_parallel_size=args.dp,
+        max_num_seqs=args.max_num_seqs,
+        max_num_batched_tokens=args.max_num_batched_tokens,
+        max_model_len=args.max_model_len,
+        gpu_memory_utilization=args.gpu_memory_utilization,
+        lookahead_tokens=min(1, int(os.getenv("DEEPINFER_USE_NEXTN_DECODE", "5"))),
+    )
+
+    import numpy as np
+
+    from deepinfer._C.engine import RequestOutput  # pyright: ignore[reportMissingModuleSource]
+    from deepinfer.sampling_params import SamplingParams
+
+    engine = llm.llm_engine
+    cache = None
+    if args.hicache_size_gb > 0:
+        try:
+            from deepinfer.hicache import HostPrefixCache
+        except ImportError:  # tree without the host prefix cache: serve without it
+            print(f"[server] deepinfer.hicache not available, prefix cache disabled (rank {dp_rank})", flush=True)
+        else:
+            cache = HostPrefixCache(engine, size_bytes=int(args.hicache_size_gb * 2**30), num_state_slots=args.hicache_state_slots)
+            engine.pe_do_save_kvcache = cache.on_prefill_step  # write-through at the end of every prefill
+    out_q.put(("ready", dp_rank, None))
+
+    def mm_data():
+        return dict(image_bytes=[], image_sizes=[]) if engine.multi_modal_processor is not None else None
+
+    def enqueue(rid: str, seq: Sequence, num_cached_tokens: int) -> None:
+        # Same as LLMEngine.add_request's _enqueue: the processor must get the sequence's own multimodal dict
+        # (overwrite_prompt wrote the text/image segments into it), plus the cached prefix length.
+        engine.scheduler.add_sequence(seq)
+        if engine.multi_modal_processor is not None:
+            engine.multi_modal_processor.add(rid, seq.multi_modal_data, num_cached_tokens)
+
+    pending = collections.deque()  # (rid, seq, prompt_ids, use_cache): created, waiting for a cache decision
+    inflight = False
+    last_stats = time.monotonic()
+    last_logged_lookups = 0
+    while True:
+        # Requests must be enqueued before the DP-wide has_unfinished_requests all-reduce,
+        # so every rank takes the same step / flush / idle branch in the same iteration.
+        while True:
+            try:
+                kind, rid, payload = in_q.get_nowait()
+            except queue.Empty:
+                break
+            if kind == "add":
+                try:
+                    prompt_ids = np.asarray(payload["prompt_token_ids"], dtype=np.int32)
+                    seq = engine.add_request(
+                        user_id="0",
+                        request_id=rid,
+                        sampling_params=SamplingParams(**payload["sampling"]),
+                        prompt_token_ids=prompt_ids,
+                        multi_modal_data=mm_data(),
+                        enqueue=cache is None,
+                    )
+                    if cache is not None:
+                        if seq is None:
+                            out_q.put(("error", rid, "request dropped: invalid prompt tokens"))
+                        else:
+                            pending.append((rid, seq, prompt_ids, payload.get("use_cache", True)))
+                except Exception as e:  # noqa: BLE001 - surface to the client, keep the rank alive
+                    out_q.put(("error", rid, repr(e)))
+            elif kind == "abort":
+                if any(p[0] == rid for p in pending):
+                    pending = collections.deque(p for p in pending if p[0] != rid)
+                else:
+                    engine.abort_request(rid)
+                if cache is not None:
+                    cache.forget(rid)
+
+        # Cache decisions, in arrival order. A hit pre-allocates the sequence's blocks and fills them from the
+        # host; if the GPU cannot allocate yet, wait (while something is running that will free memory).
+        while pending:
+            rid, seq, prompt_ids, use_cache = pending[0]
+            hit = cache.try_resume(seq, rid, prompt_ids) if use_cache else 0
+            if hit < 0 and (engine.scheduler.get_num_unfinished_seqs() > 0 or inflight):
+                break
+            pending.popleft()
+            enqueue(rid, seq, max(hit, 0))
+        if cache is not None:
+            cache.poll()
+            if time.monotonic() - last_stats > 5:
+                last_stats = time.monotonic()
+                st = cache.stats_dict()
+                out_q.put(("stats", dp_rank, st))
+                if st["lookups"] != last_logged_lookups:
+                    last_logged_lookups = st["lookups"]
+                    print(
+                        f"[hicache rank {dp_rank}] lookups {st['lookups']} hits {st['hits']} "
+                        f"token hit rate {st['hit_rate_tokens']:.1%} deferred {st['deferred']} stores {st['stores']} "
+                        f"pages {st['pages_used']}/{st['pages_total']} states {st['states_used']}/{st['states_total']} "
+                        f"evicted {st['evicted_pages']}",
+                        flush=True,
+                    )
+
+        if engine.has_unfinished_requests():
+            outputs = engine.step()
+            inflight = True
+        elif inflight:
+            outputs = engine.flush_inflight_reqs()
+            inflight = False
+        else:
+            time.sleep(0.001)
+            continue
+
+        if len(outputs):
+            # Pointers are recycled on the next step, so read the fields now.
+            batch = [
+                (
+                    RequestOutput.get_request_id(p),
+                    RequestOutput.get_token_id(p),
+                    RequestOutput.get_finished(p),
+                    RequestOutput.get_finish_reason(p),
+                    RequestOutput.get_prompt_len(p),
+                )
+                for p in outputs
+            ]
+            if cache is not None:
+                for rid, _, finished, _, _ in batch:
+                    if finished:
+                        cache.forget(rid)
+            out_q.put(("tokens", None, batch))
+
+
+# --------------------------------------------------------------------------- HTTP side
+
+
+class IncrementalDetokenizer:
+    """vLLM-style prefix/read offsets so each delta decodes only a short tail."""
+
+    def __init__(self, tokenizer: Any) -> None:
+        self.tok = tokenizer
+        self.ids: list[int] = []
+        self.num_tokens = 0
+        self.prefix_offset = 0
+        self.read_offset = 0
+
+    def add(self, token_id: int) -> str:
+        self.num_tokens += 1
+        if token_id == self.tok.eos_token_id:
+            return ""
+        self.ids.append(token_id)
+        prefix = self.tok.decode(self.ids[self.prefix_offset : self.read_offset], skip_special_tokens=False)
+        full = self.tok.decode(self.ids[self.prefix_offset :], skip_special_tokens=False)
+        if len(full) > len(prefix) and not full.endswith("�"):
+            self.prefix_offset, self.read_offset = self.read_offset, len(self.ids)
+            return full[len(prefix) :]
+        return ""
+
+
+class Frontend:
+    def __init__(self, args: argparse.Namespace) -> None:
+        from transformers import AutoTokenizer
+
+        sys.path.insert(0, str(Path(args.model) / "encoding"))
+        from encoding import encode_messages  # the checkpoint's own prompt-format reference
+
+        self.args = args
+        self.model_name = args.served_model_name or args.model
+        self.encode_messages = encode_messages
+        self.tokenizer = AutoTokenizer.from_pretrained(args.model)
+        ctx = mp.get_context("spawn")
+        self.out_q: mp.Queue = ctx.Queue()
+        self.in_qs: list[mp.Queue] = [ctx.Queue() for _ in range(args.dp)]
+        # Not daemonic: the engine forks its own helper processes (as examples/_launch.py allows).
+        self.procs = [ctx.Process(target=worker_main, args=(args, r, self.in_qs[r], self.out_q), daemon=False) for r in range(args.dp)]
+        self.load = [0] * args.dp
+        self.owner: dict[str, int] = {}
+        self.streams: dict[str, asyncio.Queue] = {}
+        self.ready = 0
+        self.stats = dict(requests=0, finished=0, aborted=0, errors=0, prompt_tokens=0, completion_tokens=0, encode_fallbacks=0)
+        self.cache_stats: dict[int, dict] = {}
+        self.loop: asyncio.AbstractEventLoop | None = None
+
+    def start(self) -> None:
+        for p in self.procs:
+            p.start()
+
+    def dispatch_forever(self) -> None:
+        """Thread: fan engine outputs out to the per-request asyncio queues."""
+        while True:
+            try:
+                kind, rid, payload = self.out_q.get(timeout=1.0)
+            except queue.Empty:
+                dead = [r for r, p in enumerate(self.procs) if not p.is_alive()]
+                if dead:
+                    print(f"[server] engine rank(s) {dead} died; failing open requests and exiting", flush=True)
+                    for rid in list(self.streams):
+                        self.loop.call_soon_threadsafe(self._deliver, rid, ("error", f"engine rank died: {dead}"))
+                    time.sleep(2)
+                    os._exit(1)
+                continue
+            if kind == "ready":
+                self.ready += 1
+                print(f"[server] DP rank {rid} ready ({self.ready}/{self.args.dp})", flush=True)
+            elif kind == "error":
+                self.loop.call_soon_threadsafe(self._deliver, rid, ("error", payload))
+            elif kind == "stats":
+                self.cache_stats[rid] = payload
+            else:
+                self.loop.call_soon_threadsafe(self._deliver_batch, payload)
+
+    def _deliver(self, rid: str, item: tuple) -> None:
+        q = self.streams.get(rid)
+        if q is not None:
+            q.put_nowait(item)
+
+    def _deliver_batch(self, batch: list[tuple]) -> None:
+        for rid, token_id, finished, reason, prompt_len in batch:
+            q = self.streams.get(rid)
+            if q is not None:
+                q.put_nowait(("token", token_id, finished, reason, prompt_len))
+
+    def render_prompt(self, body: dict) -> list[int]:
+        messages = [dict(m) for m in body["messages"]]
+        if body.get("tools"):
+            if not messages or messages[0].get("role") != "system":
+                messages.insert(0, {"role": "system", "content": ""})
+            messages[0]["tools"] = body["tools"]
+        try:
+            prompt = self.encode_messages(messages, thinking_mode=self.args.thinking_mode)
+        except Exception:  # noqa: BLE001 - trace messages the reference encoder rejects
+            # Keep the request (and its prompt length) instead of failing the benchmark.
+            self.stats["encode_fallbacks"] += 1
+            parts = ["<｜begin▁of▁sentence｜>"]
+            for m in messages:
+                content = m.get("content") or ""
+                if isinstance(content, list):
+                    content = "".join(b.get("text", "") for b in content if isinstance(b, dict))
+                if m.get("tool_calls"):
+                    content += json.dumps(m["tool_calls"], ensure_ascii=False)
+                tag = {"user": "<｜User｜>", "assistant": "<｜Assistant｜>", "tool": "<｜User｜>"}.get(m.get("role"), "")
+                parts.append(tag + content)
+            if body.get("tools"):
+                parts.insert(1, json.dumps(body["tools"], ensure_ascii=False))
+            prompt = "".join(parts) + "<｜Assistant｜></think>"
+        return self.tokenizer.encode(prompt, add_special_tokens=False)
+
+    @staticmethod
+    def affinity_key(body: dict) -> bytes | None:
+        """Stable per-conversation key: the first user message (AgentX's cache-bust marker lives there and is
+        constant across a trajectory's turns, and forked subagents inherit it)."""
+        for m in body.get("messages", []):
+            if m.get("role") == "user":
+                content = m.get("content") or ""
+                if isinstance(content, list):
+                    content = "".join(b.get("text", "") for b in content if isinstance(b, dict))
+                return hashlib.sha1(content[:4096].encode("utf-8", "ignore")).digest()
+        return None
+
+    def submit(self, prompt_ids: list[int], sampling: dict, key: bytes | None = None, use_cache: bool = True) -> tuple[str, asyncio.Queue]:
+        rid = uuid.uuid4().hex
+        if self.args.routing == "affinity" and key is not None:
+            rank = int.from_bytes(key[:4], "little") % self.args.dp
+        else:
+            rank = min(range(self.args.dp), key=lambda r: self.load[r])
+        self.load[rank] += 1
+        self.owner[rid] = rank
+        q: asyncio.Queue = asyncio.Queue()
+        self.streams[rid] = q
+        self.stats["requests"] += 1
+        self.in_qs[rank].put(("add", rid, {"prompt_token_ids": prompt_ids, "sampling": sampling, "use_cache": use_cache}))
+        return rid, q
+
+    def release(self, rid: str, aborted: bool) -> None:
+        rank = self.owner.pop(rid, None)
+        self.streams.pop(rid, None)
+        if rank is None:
+            return
+        self.load[rank] -= 1
+        if aborted:
+            self.stats["aborted"] += 1
+            self.in_qs[rank].put(("abort", rid, None))
+        else:
+            self.stats["finished"] += 1
+
+
+def build_app(fe: Frontend) -> FastAPI:
+    from fastapi import FastAPI
+    from fastapi.responses import JSONResponse, PlainTextResponse, StreamingResponse
+
+    app = FastAPI()
+
+    @app.on_event("startup")
+    async def _startup() -> None:
+        fe.loop = asyncio.get_running_loop()
+        threading.Thread(target=fe.dispatch_forever, daemon=True).start()
+
+    @app.get("/health")
+    async def health():
+        ok = fe.ready == fe.args.dp
+        return JSONResponse({"status": "ok" if ok else "loading", "ready_ranks": fe.ready}, status_code=200 if ok else 503)
+
+    @app.get("/v1/models")
+    async def models():
+        return {"object": "list", "data": [{"id": fe.model_name, "object": "model", "owned_by": "deepinfer"}]}
+
+    # Not at /metrics: aiperf scrapes that path automatically and InferenceX's aggregator
+    # rejects metric families it has no backend adapter for.
+    @app.get("/deepinfer/metrics")
+    async def metrics():
+        lines = [f"deepinfer:{k}_total {v}" for k, v in fe.stats.items()]
+        lines += [f'deepinfer:num_requests_running{{dp_rank="{r}"}} {n}' for r, n in enumerate(fe.load)]
+        for r, st in sorted(fe.cache_stats.items()):
+            lines += [f'deepinfer_hicache:{k}{{dp_rank="{r}"}} {v}' for k, v in st.items()]
+        return PlainTextResponse("\n".join(lines) + "\n")
+
+    @app.post("/v1/chat/completions")
+    async def chat(request: Request):
+        if fe.ready != fe.args.dp:
+            return JSONResponse({"error": {"message": "engine loading"}}, status_code=503)
+        body = await request.json()
+        prompt_ids = await asyncio.to_thread(fe.render_prompt, body)
+        max_tokens = body.get("max_completion_tokens") or body.get("max_tokens") or 4096
+        if len(prompt_ids) + 1 > fe.args.max_model_len:
+            return JSONResponse({"error": {"message": f"prompt has {len(prompt_ids)} tokens > max_model_len"}}, status_code=400)
+        max_tokens = max(1, min(int(max_tokens), fe.args.max_model_len - len(prompt_ids)))
+        sampling = dict(
+            temperature=float(body.get("temperature", 1.0)),
+            top_p=float(body.get("top_p", 1.0)),
+            ignore_eos=bool(body.get("ignore_eos", False)),
+            max_tokens=max_tokens,
+        )
+        if body.get("seed") is not None:
+            sampling["seq_seed"] = int(body["seed"])
+        fe.stats["prompt_tokens"] += len(prompt_ids)
+        include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+        # Non-standard request field: "prefix_cache": false bypasses the host prefix cache lookup (A/B checks).
+        rid, q = fe.submit(prompt_ids, sampling, fe.affinity_key(body), use_cache=bool(body.get("prefix_cache", True)))
+        created = int(time.time())
+        cid = f"chatcmpl-{rid}"
+        detok = IncrementalDetokenizer(fe.tokenizer)
+
+        def chunk(delta: dict, finish: str | None = None, usage: dict | None = None) -> str:
+            obj = {
+                "id": cid,
+                "object": "chat.completion.chunk",
+                "created": created,
+                "model": fe.model_name,
+                "choices": [] if usage else [{"index": 0, "delta": delta, "finish_reason": finish}],
+            }
+            if usage:
+                obj["usage"] = usage
+            return f"data: {json.dumps(obj, ensure_ascii=False)}\n\n"
+
+        async def tokens():
+            """Yield (text_delta, finish_reason) until the request finishes."""
+            while True:
+                item = await q.get()
+                if item[0] == "error":
+                    raise RuntimeError(item[1])
+                _, token_id, finished, reason, _ = item
+                text = detok.add(token_id)
+                fe.stats["completion_tokens"] += 1
+                if finished:
+                    yield text, ("length" if detok.num_tokens >= max_tokens else "stop")
+                    return
+                yield text, None
+
+        usage = lambda: {
+            "prompt_tokens": len(prompt_ids),
+            "completion_tokens": detok.num_tokens,  # noqa: E731
+            "total_tokens": len(prompt_ids) + detok.num_tokens,
+        }
+
+        if body.get("stream"):
+
+            async def sse():
+                done = False
+                try:
+                    yield chunk({"role": "assistant", "content": ""})
+                    async for text, finish in tokens():  # noqa: B007  (the last finish reason is reported below)
+                        if text or finish:
+                            yield chunk({"content": text} if text else {}, finish)
+                    done = True
+                    if include_usage:
+                        yield chunk({}, usage=usage())
+                    yield "data: [DONE]\n\n"
+                finally:
+                    fe.release(rid, aborted=not done)
+
+            return StreamingResponse(sse(), media_type="text/event-stream")
+
+        done = False
+        try:
+            parts, finish = [], None
+            async for text, finish in tokens():  # noqa: B007  (the last finish reason is reported below)
+                parts.append(text)
+            done = True
+        finally:
+            fe.release(rid, aborted=not done)
+        return {
+            "id": cid,
+            "object": "chat.completion",
+            "created": created,
+            "model": fe.model_name,
+            "choices": [{"index": 0, "message": {"role": "assistant", "content": "".join(parts)}, "finish_reason": finish}],
+            "usage": usage(),
+        }
+
+    return app
+
+
+def main() -> None:
+    args = parse_args()
+    args.model = str(Path(args.model).expanduser().resolve())
+    os.environ.setdefault("WORLD_SIZE", "1")
+    os.environ.setdefault("RANK", "0")
+    fe = Frontend(args)
+    fe.start()
+
+    import uvicorn
+
+    uvicorn.run(build_app(fe), host=args.host, port=args.port, log_level="warning", timeout_keep_alive=900)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/serve/pd_run.sh b/serve/pd_run.sh
new file mode 100755
index 0000000..f61a451
--- /dev/null
+++ b/serve/pd_run.sh
@@ -0,0 +1,49 @@
+#!/bin/bash
+# Start/stop the prefill (PE) and decode (CE) trays of serve/pd_server.py over ssh.
+#
+#   serve/pd_run.sh start <pe-host> <ce-host> [extra pd_server args...]
+#   serve/pd_run.sh stop  <pe-host> <ce-host>
+#   serve/pd_run.sh log   <host>              # tail the tray's log
+#
+# Ports: PE HTTP 8889, CE HTTP (user-facing) 8888, CE KV receivers 8900+rank. Logs: ~/pd_<role>.log on each tray.
+set -euo pipefail
+CMD="${1:?start|stop|log}"; shift
+MODEL="${DEEPINFER_HF_MODEL_DIR:-$HOME/models/DeepSeek-V4.1-Flash-1017}"
+SERVED=deepseek-ai/DeepSeek-V4.1-Flash-1017
+ENV='cd ~/DeepInfer && source env.sh && export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0,1,2,3}'
+
+launch() {  # host role args...
+    local host=$1 role=$2; shift 2
+    # ssh -n + nohup with every fd redirected, otherwise the remote session stays attached to the server.
+    ssh -n "$host" "$ENV && rm -f ~/pd_$role.pgid && nohup setsid python -u serve/pd_server.py --role $role --model $MODEL --served-model-name $SERVED $* > ~/pd_$role.log 2>&1 < /dev/null & echo \$! > ~/pd_$role.pgid; echo started $role on \$(hostname) pgid \$(cat ~/pd_$role.pgid)"
+}
+wait_ready() {  # host port
+    local i
+    for i in $(seq 200); do
+        if curl -fs "http://$1:$2/health" >/dev/null 2>&1; then echo "$1:$2 ready"; return 0; fi
+        sleep 3
+    done
+    echo "$1:$2 did not become ready" >&2; return 1
+}
+
+case "$CMD" in
+    start)
+        PE=${1:?pe-host}; CE=${2:?ce-host}; shift 2
+        launch "$PE" pe --port 8889 "$@"
+        launch "$CE" ce --port 8888 --kv-port 8900 --kv-host "$CE" --pe-url "http://$PE:8889" "$@"
+        wait_ready "$PE" 8889; wait_ready "$CE" 8888
+        ;;
+    stop)
+        for spec in "${1:?pe-host}:pe" "${2:?ce-host}:ce"; do
+            h=${spec%%:*}; r=${spec##*:}
+            # Kill by pid list, excluding the remote shell itself: a pkill -f pattern would match this very
+            # command line (it names pd_server.py) and kill the shell before anything else runs.
+            # Frontend + its spawned engine workers, SIGKILL (uvicorn's graceful shutdown otherwise keeps the
+            # children, and the GPUs, alive for minutes); then wait until the GPUs are actually free.
+            ssh -n "$h" "for p in \$(pgrep -f '[p]d_server.py --role $r|multiprocessing.spawn|multiprocessing.resource_tracker'); do [ \"\$p\" != \"\$\$\" ] && kill -9 \"\$p\" 2>/dev/null; done; rm -f ~/pd_$r.pgid; for i in \$(seq 60); do [ \"\$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | sort -n | tail -1)\" -lt 1000 ] && break; sleep 3; done; echo stopped $r on \$(hostname), gpu mem \$(nvidia-smi --query-gpu=memory.used --format=csv,noheader | tr '\\n' ' ')" || true
+        done
+        ;;
+    log)
+        ssh "${1:?host}" 'tail -n 40 ~/pd_*.log'
+        ;;
+esac
diff --git a/serve/pd_server.py b/serve/pd_server.py
new file mode 100644
index 0000000..d94672e
--- /dev/null
+++ b/serve/pd_server.py
@@ -0,0 +1,682 @@
+"""Prefill/decode-disaggregated serving: a prompt-only engine tray (PE) and a decode-only engine tray (CE).
+
+    # decode tray (user-facing OpenAI API on --port, KV receivers on --kv-port + rank):
+    python serve/pd_server.py --role ce --model ... --dp 4 --port 8888 --kv-port 8900 --pe-url http://<pe-host>:8889
+    # prefill tray:
+    python serve/pd_server.py --role pe --model ... --dp 4 --port 8889
+
+Flow per request: CE frontend renders the prompt, picks a CE rank, POSTs /prefill to the PE with the KV target
+(ce-host, kv-port + rank). The PE prefills (host prefix cache on), exports the sequence's KV blocks + full SWA
+state (deepinfer.hicache.pd_transfer) and the first sampled token, streams the first token back in the HTTP
+response and pushes the KV bytes to the CE rank over TCP. The CE rank admits the sequence straight into decode
+(Scheduler.add_prompted_sequence); its tokens stream to the client through the CE frontend.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import collections
+import json
+import multiprocessing as mp
+import os
+import queue
+import socket
+import struct
+import sys
+import threading
+import time
+import uuid
+from collections.abc import Callable
+from pathlib import Path
+from types import ModuleType
+from typing import TYPE_CHECKING
+
+from fastapi import FastAPI, Request
+
+if TYPE_CHECKING:
+    from deepinfer._C.engine import RequestOutput, Sequence
+    from deepinfer.engine.llm_engine import LLMEngine
+    from deepinfer.hicache.pd_transfer import PDTransfer
+    from deepinfer.sampling_params import SamplingParams
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+sys.path.insert(0, str(HERE.parent / "examples"))
+
+import openai_server as oas  # noqa: E402  (the single-engine server: prompt rendering, detokenizer, frontend plumbing)
+
+HDR = struct.Struct("<16sqqqqq")  # rid(16 bytes hex) | first_token | prompt_len | num_pages | page_bytes | state_bytes
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser()
+    p.add_argument("--role", required=True, choices=["pe", "ce"])
+    p.add_argument("--model", required=True)
+    p.add_argument("--served-model-name", default=None)
+    p.add_argument("--dp", type=int, default=4)
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8888)
+    p.add_argument("--kv-port", type=int, default=8900, help="ce: TCP receiver base port (+ rank)")
+    p.add_argument("--kv-host", default=None, help="ce: address the PE should push KV to (default: this host's name)")
+    p.add_argument("--pe-url", default=None, help="ce: prefill tray URL")
+    p.add_argument("--max-model-len", type=int, default=1 << 20)
+    p.add_argument("--max-num-seqs", type=int, default=128)
+    p.add_argument("--max-num-batched-tokens", type=int, default=32768)
+    p.add_argument("--gpu-memory-utilization", type=float, default=0.9)
+    p.add_argument("--yoco-keep-tokens", type=int, default=140)
+    p.add_argument("--thinking-mode", default="chat", choices=["chat", "thinking"])
+    p.add_argument("--log-interval-steps", type=int, default=200)
+    p.add_argument("--hicache-size-gb", type=float, default=32, help="pe: host prefix cache per rank (0 disables)")
+    p.add_argument("--hicache-state-slots", type=int, default=4096)
+    p.add_argument("--routing", default="affinity", choices=["affinity", "least-loaded"])
+    p.add_argument("--prefill-any-interval", type=int, default=2)
+    return p.parse_args()
+
+
+def _recv_exact(sock: socket.socket, buf: memoryview) -> None:
+    view = buf
+    while len(view):
+        n = sock.recv_into(view, min(len(view), 1 << 24))
+        if n == 0:
+            raise ConnectionError("peer closed during transfer")
+        view = view[n:]
+
+
+# ============================================================================ engine processes
+
+
+def worker_main(args: argparse.Namespace, dp_rank: int, in_q: mp.Queue, out_q: mp.Queue) -> None:
+    import ctypes
+    import signal
+
+    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
+
+    import numpy as np
+    from _config import create_llm, setup_common_env
+
+    from deepinfer.engine.engine_type import EngineType
+
+    if args.yoco_keep_tokens > 0:
+        os.environ["DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE"] = "compact"
+        os.environ["DEEPINFER_YOCO_PREFILL_KEEP_TOKENS"] = str(args.yoco_keep_tokens)
+        os.environ["DEEPINFER_PREFILL_STORE_EXTRA_STATE"] = "1"
+    os.environ.setdefault("DEEPINFER_PREFILL_STORE_EXTRA_SIZE", "512")  # identical state layout on PE and CE
+    os.environ.setdefault("DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL", str(args.prefill_any_interval))
+    setup_common_env(model_name=args.model, sampler_force_topk=1024, set_override_experts=True, enable_eplb=True)
+
+    engine_type = EngineType.PROMPT if args.role == "pe" else EngineType.COMPLETION
+    llm = create_llm(
+        args.model,
+        dp_rank,
+        ep_size=args.dp,
+        env={"DEEPINFER_LOGGING_INTERVAL_STEP": str(args.log_interval_steps)},
+        data_parallel_size=args.dp,
+        max_num_seqs=args.max_num_seqs,
+        max_num_batched_tokens=args.max_num_batched_tokens,
+        max_model_len=args.max_model_len,
+        gpu_memory_utilization=args.gpu_memory_utilization,
+        lookahead_tokens=min(1, int(os.getenv("DEEPINFER_USE_NEXTN_DECODE", "5"))),
+        engine_type=engine_type,
+        stop_preempted_request=True,
+    )
+
+    from deepinfer._C.engine import RequestOutput  # pyright: ignore[reportMissingModuleSource]
+    from deepinfer.hicache.pd_transfer import PDTransfer
+    from deepinfer.sampling_params import SamplingParams
+
+    engine = llm.llm_engine
+    transfer = PDTransfer(engine)
+    mm = lambda: dict(image_bytes=[], image_sizes=[]) if engine.multi_modal_processor is not None else None  # noqa: E731
+
+    def enqueue(rid: str, seq: Sequence, num_cached: int) -> None:
+        engine.scheduler.add_sequence(seq)
+        if engine.multi_modal_processor is not None:
+            engine.multi_modal_processor.add(rid, seq.multi_modal_data, num_cached)
+
+    if args.role == "pe":
+        _pe_loop(args, dp_rank, in_q, out_q, engine, transfer, SamplingParams, RequestOutput, np, mm, enqueue)
+    else:
+        _ce_loop(args, dp_rank, in_q, out_q, engine, transfer, SamplingParams, RequestOutput, np, mm)
+
+
+def _pe_loop(
+    args: argparse.Namespace,
+    dp_rank: int,
+    in_q: mp.Queue,
+    out_q: mp.Queue,
+    engine: LLMEngine,
+    transfer: PDTransfer,
+    SamplingParams: type[SamplingParams],
+    RequestOutput: type[RequestOutput],
+    np: ModuleType,
+    mm: Callable[[], dict | None],
+    enqueue: Callable[[str, Sequence, int], None],
+) -> None:
+    cache = None
+    if args.hicache_size_gb > 0:
+        from deepinfer.hicache import HostPrefixCache
+
+        cache = HostPrefixCache(engine, size_bytes=int(args.hicache_size_gb * 2**30), num_state_slots=args.hicache_state_slots)
+
+    targets: dict[str, tuple[str, int]] = {}  # rid -> (host, port) of the CE rank
+    awaiting_token: dict[str, dict] = {}  # rid -> transfer waiting for the step's sampled first token
+    send_q: queue.Queue = queue.Queue()
+
+    def on_prefill_step(scheduled: list[Sequence], finished: list[Sequence]) -> None:
+        # Engine hook at the start of post-processing for a prompt step: the prefill's KV is complete and the
+        # sequence still owns its blocks (with max_tokens=1 it finishes, and is freed, once outputs are processed).
+        if cache is not None:
+            cache.on_prefill_step(scheduled, finished)
+        for seq in scheduled:
+            rid = seq.request_id
+            if seq.chunked_rest_len != 0 or rid not in targets:
+                continue
+            prompt_len = seq.get_len()  # no output appended yet
+            need = (prompt_len + transfer.block_size - 1) // transfer.block_size
+            if len(seq.block_table) < need:
+                out_q.put(("error", rid, f"prefilled sequence has {len(seq.block_table)} blocks, needs {need}"))
+                targets.pop(rid, None)
+                continue
+            pages, state, ev = transfer.export(seq, prompt_len)
+            item = {
+                "pages": pages,
+                "state": state,
+                "event": ev,
+                "prompt_len": prompt_len,
+                "target": targets.pop(rid),
+                "first_token": None,
+                "ready": threading.Event(),
+            }
+            awaiting_token[rid] = item
+            send_q.put((rid, item))
+
+    engine.pe_do_save_kvcache = on_prefill_step
+
+    def sender():
+        while True:
+            rid, item = send_q.get()
+            host, port = item["target"]
+            try:
+                item["ready"].wait(timeout=600)
+                if item["first_token"] is None:
+                    raise RuntimeError("no first token produced for the prefilled sequence")
+                item["event"].synchronize()
+                pages, state = item["pages"], item["state"]
+                with socket.create_connection((host, port), timeout=60) as s:
+                    s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+                    s.sendall(
+                        HDR.pack(rid.encode()[:16], item["first_token"], item["prompt_len"], pages.size(0), pages.size(1), state.numel())
+                    )
+                    s.sendall(memoryview(pages.numpy()).cast("B"))
+                    s.sendall(memoryview(state.numpy()).cast("B"))
+                    ack = s.recv(2)
+                if ack != b"ok":
+                    out_q.put(("error", rid, f"CE rejected transfer: {ack!r}"))
+            except Exception as e:  # noqa: BLE001
+                out_q.put(("error", rid, f"KV transfer to {host}:{port} failed: {e!r}"))
+
+    threading.Thread(target=sender, daemon=True).start()
+    out_q.put(("ready", dp_rank, None))
+
+    pending = collections.deque()
+    inflight = False
+    last_stats = time.monotonic()
+    while True:
+        while True:
+            try:
+                kind, rid, payload = in_q.get_nowait()
+            except queue.Empty:
+                break
+            if kind == "add":
+                try:
+                    prompt_ids = np.asarray(payload["prompt_token_ids"], dtype=np.int32)
+                    sp = SamplingParams(**payload["sampling"])
+                    sp.max_tokens = 1  # prefill + first token only; the engine then finishes and frees the sequence
+                    seq = engine.add_request(
+                        user_id="0", request_id=rid, sampling_params=sp, prompt_token_ids=prompt_ids, multi_modal_data=mm(), enqueue=False
+                    )
+                    if seq is None:
+                        out_q.put(("error", rid, "request dropped: invalid prompt tokens"))
+                    else:
+                        targets[rid] = tuple(payload["kv_target"])
+                        pending.append((rid, seq, prompt_ids))
+                except Exception as e:  # noqa: BLE001
+                    out_q.put(("error", rid, repr(e)))
+            elif kind == "abort":
+                targets.pop(rid, None)
+                if any(p[0] == rid for p in pending):
+                    pending = collections.deque(p for p in pending if p[0] != rid)
+                else:
+                    engine.abort_request(rid)
+                if cache is not None:
+                    cache.forget(rid)
+        while pending:
+            rid, seq, prompt_ids = pending[0]
+            hit = cache.try_resume(seq, rid, prompt_ids) if cache is not None else 0
+            if hit < 0 and (engine.scheduler.get_num_unfinished_seqs() > 0 or inflight):
+                break
+            pending.popleft()
+            enqueue(rid, seq, max(hit, 0))
+        if cache is not None:
+            cache.poll()
+            if time.monotonic() - last_stats > 5:
+                last_stats = time.monotonic()
+                out_q.put(("stats", dp_rank, cache.stats_dict()))
+
+        if engine.has_unfinished_requests():
+            outputs = engine.step()
+            inflight = True
+        elif inflight:
+            outputs = engine.flush_inflight_reqs()
+            inflight = False
+        else:
+            time.sleep(0.001)
+            continue
+        if len(outputs):
+            batch = [
+                (
+                    RequestOutput.get_request_id(p),
+                    RequestOutput.get_token_id(p),
+                    RequestOutput.get_finished(p),
+                    RequestOutput.get_finish_reason(p),
+                    RequestOutput.get_prompt_len(p),
+                )
+                for p in outputs
+            ]
+            for rid, token_id, finished, _, _ in batch:
+                item = awaiting_token.pop(rid, None)
+                if item is not None:
+                    item["first_token"] = int(token_id)
+                    item["ready"].set()
+                if finished and cache is not None:
+                    cache.forget(rid)
+            out_q.put(("tokens", None, batch))
+        # A prompt-only engine never reclaims finished sequences by itself (that happens in the decode
+        # scheduler): drop them from `running` and free their blocks/state. The export and cache copies were
+        # enqueued on the stream before any kernel that could reuse those blocks.
+        for seq in engine.scheduler.free_finished_seqs():
+            engine.scheduler.free_seq(seq)
+
+
+def _ce_loop(
+    args: argparse.Namespace,
+    dp_rank: int,
+    in_q: mp.Queue,
+    out_q: mp.Queue,
+    engine: LLMEngine,
+    transfer: PDTransfer,
+    SamplingParams: type[SamplingParams],
+    RequestOutput: type[RequestOutput],
+    np: ModuleType,
+    mm: Callable[[], dict | None],
+) -> None:
+    import torch
+
+    recv_q: queue.Queue = queue.Queue()  # (rid, first_token, prompt_len, pages, state)
+
+    def receiver():
+        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        srv.bind((args.host, args.kv_port + dp_rank))
+        srv.listen(64)
+        while True:
+            conn, _ = srv.accept()
+            threading.Thread(target=receive_one, args=(conn,), daemon=True).start()
+
+    def receive_one(conn: socket.socket):
+        try:
+            with conn:
+                hdr = bytearray(HDR.size)
+                _recv_exact(conn, memoryview(hdr))
+                rid_b, first_token, prompt_len, num_pages, page_bytes, state_bytes = HDR.unpack(hdr)
+                rid = rid_b.decode()
+                assert page_bytes == transfer.page_bytes and state_bytes == transfer.state_bytes, "layout mismatch between PE and CE"
+                pages = torch.empty((num_pages, page_bytes), dtype=torch.uint8, pin_memory=True)
+                state = torch.empty(state_bytes, dtype=torch.uint8, pin_memory=True)
+                _recv_exact(conn, memoryview(pages.numpy()).cast("B"))
+                _recv_exact(conn, memoryview(state.numpy()).cast("B"))
+                recv_q.put((rid, first_token, prompt_len, pages, state))
+                conn.sendall(b"ok")
+        except Exception as e:  # noqa: BLE001
+            print(f"[ce rank {dp_rank}] transfer failed: {e!r}", flush=True)
+
+    threading.Thread(target=receiver, daemon=True).start()
+    out_q.put(("ready", dp_rank, None))
+
+    expected: dict[str, dict] = {}  # rid -> {"prompt_token_ids", "sampling"} from the frontend
+    arrived: dict[str, tuple] = {}  # rid -> transfer
+    pending: collections.deque = collections.deque()  # rids with both parts, waiting for GPU allocation
+    keep: dict[str, torch.cuda.Event] = {}
+    inflight = False
+    while True:
+        while True:
+            try:
+                kind, rid, payload = in_q.get_nowait()
+            except queue.Empty:
+                break
+            if kind == "expect":
+                expected[rid] = payload
+                if rid in arrived:
+                    pending.append(rid)
+            elif kind == "abort":
+                expected.pop(rid, None)
+                arrived.pop(rid, None)
+                if rid in pending:
+                    pending.remove(rid)
+                else:
+                    engine.abort_request(rid)
+        while True:
+            try:
+                rid, first_token, prompt_len, pages, state = recv_q.get_nowait()
+            except queue.Empty:
+                break
+            arrived[rid] = (first_token, prompt_len, pages, state)
+            if rid in expected:
+                pending.append(rid)
+        while pending:
+            rid = pending[0]
+            spec, (first_token, prompt_len, pages, state) = expected[rid], arrived[rid]
+            tokens = np.asarray(list(spec["prompt_token_ids"]) + [first_token], dtype=np.int32)
+            assert len(tokens) - 1 == prompt_len, (len(tokens), prompt_len)
+            sp = SamplingParams(**spec["sampling"])
+            sp.max_tokens = max(1, sp.max_tokens - 1)  # the first token was produced on the PE
+            seq = engine.add_request(
+                user_id="0", request_id=rid, sampling_params=sp, prompt_token_ids=tokens, multi_modal_data=mm(), enqueue=False
+            )
+            if seq is None:
+                out_q.put(("error", rid, "request dropped: invalid prompt tokens"))
+                pending.popleft()
+                expected.pop(rid, None)
+                arrived.pop(rid, None)
+                continue
+            try:
+                allocated = engine.scheduler.try_allocate_seq(seq)
+            except RuntimeError as e:
+                out_q.put(("error", rid, f"cannot allocate: {e!r}"))
+                allocated = None
+            if allocated is False and (engine.scheduler.get_num_unfinished_seqs() > 0 or inflight):
+                break  # retry once something finishes
+            pending.popleft()
+            expected.pop(rid, None)
+            arrived.pop(rid, None)
+            if not allocated:
+                if allocated is False:
+                    out_q.put(("error", rid, "cannot allocate KV blocks for the transferred sequence"))
+                continue
+            # Keep the pinned receive buffers alive until the H2D page-copy kernels have consumed them: the kernel
+            # reads them by raw pointer, so the caching host allocator would otherwise hand the memory to the next
+            # transfer (or unmap it) while the copy is still queued -> corrupted KV / cudaErrorLaunchFailure.
+            keep[rid] = (transfer.admit(seq, pages, state, prompt_len), pages, state)
+            if engine.multi_modal_processor is not None:
+                engine.multi_modal_processor.add(rid, seq.multi_modal_data, prompt_len)
+        for rid in [r for r, (ev, _, _) in keep.items() if ev.query()]:
+            del keep[rid]
+
+        if engine.has_unfinished_requests():
+            outputs = engine.step()
+            inflight = True
+        elif inflight:
+            outputs = engine.flush_inflight_reqs()
+            inflight = False
+        else:
+            time.sleep(0.001)
+            continue
+        if len(outputs):
+            batch = [
+                (
+                    RequestOutput.get_request_id(p),
+                    RequestOutput.get_token_id(p),
+                    RequestOutput.get_finished(p),
+                    RequestOutput.get_finish_reason(p),
+                    RequestOutput.get_prompt_len(p),
+                )
+                for p in outputs
+            ]
+            out_q.put(("tokens", None, batch))
+
+
+# ============================================================================ frontends
+
+
+class PDFrontend(oas.Frontend):
+    def __init__(self, args: argparse.Namespace) -> None:
+        super().__init__(args)
+        ctx = mp.get_context("spawn")
+        self.out_q = ctx.Queue()
+        self.in_qs = [ctx.Queue() for _ in range(args.dp)]
+        self.procs = [ctx.Process(target=worker_main, args=(args, r, self.in_qs[r], self.out_q), daemon=False) for r in range(args.dp)]
+
+
+def build_pe_app(fe: PDFrontend) -> FastAPI:
+    """Prefill tray: POST /prefill {rid, prompt_token_ids, sampling, kv_target:[host,port]} -> {first_token}."""
+    from fastapi import FastAPI
+    from fastapi.responses import JSONResponse
+
+    app = FastAPI()
+
+    @app.on_event("startup")
+    async def _startup() -> None:
+        fe.loop = asyncio.get_running_loop()
+        threading.Thread(target=fe.dispatch_forever, daemon=True).start()
+
+    @app.get("/health")
+    async def health():
+        ok = fe.ready == fe.args.dp
+        return JSONResponse({"status": "ok" if ok else "loading", "ready_ranks": fe.ready, "role": "pe"}, status_code=200 if ok else 503)
+
+    @app.get("/deepinfer/metrics")
+    async def metrics():
+        lines = [f"deepinfer:{k}_total {v}" for k, v in fe.stats.items()]
+        for r, st in sorted(fe.cache_stats.items()):
+            lines += [f'deepinfer_hicache:{k}{{dp_rank="{r}"}} {v}' for k, v in st.items()]
+        return "\n".join(lines) + "\n"
+
+    @app.post("/prefill")
+    async def prefill(request: Request):
+        if fe.ready != fe.args.dp:
+            return JSONResponse({"error": "engine loading"}, status_code=503)
+        body = await request.json()
+        rid = body["rid"]
+        rank = min(range(fe.args.dp), key=lambda r: fe.load[r])
+        key = bytes.fromhex(body["affinity"]) if body.get("affinity") else None
+        if fe.args.routing == "affinity" and key is not None:
+            rank = int.from_bytes(key[:4], "little") % fe.args.dp
+        fe.load[rank] += 1
+        fe.owner[rid] = rank
+        q: asyncio.Queue = asyncio.Queue()
+        fe.streams[rid] = q
+        fe.stats["requests"] += 1
+        fe.in_qs[rank].put(
+            ("add", rid, {"prompt_token_ids": body["prompt_token_ids"], "sampling": body["sampling"], "kv_target": body["kv_target"]})
+        )
+        try:
+            item = await asyncio.wait_for(q.get(), timeout=1800)
+        finally:
+            fe.release(rid, aborted=False)
+        if item[0] == "error":
+            return JSONResponse({"error": item[1]}, status_code=500)
+        return {"first_token": item[1], "prompt_len": item[4]}
+
+    return app
+
+
+def build_ce_app(fe: PDFrontend, pe_url: str, kv_host: str) -> FastAPI:
+    """Decode tray: the user-facing OpenAI API."""
+    import httpx
+    from fastapi import FastAPI
+    from fastapi.responses import JSONResponse, StreamingResponse
+
+    app = FastAPI()
+    client = httpx.AsyncClient(timeout=1800)
+
+    @app.on_event("startup")
+    async def _startup() -> None:
+        fe.loop = asyncio.get_running_loop()
+        threading.Thread(target=fe.dispatch_forever, daemon=True).start()
+
+    @app.get("/health")
+    async def health():
+        ok = fe.ready == fe.args.dp
+        return JSONResponse({"status": "ok" if ok else "loading", "ready_ranks": fe.ready, "role": "ce"}, status_code=200 if ok else 503)
+
+    @app.get("/v1/models")
+    async def models():
+        return {"object": "list", "data": [{"id": fe.model_name, "object": "model", "owned_by": "deepinfer"}]}
+
+    @app.get("/deepinfer/metrics")
+    async def metrics():
+        lines = [f"deepinfer:{k}_total {v}" for k, v in fe.stats.items()]
+        lines += [f'deepinfer:num_requests_running{{dp_rank="{r}"}} {n}' for r, n in enumerate(fe.load)]
+        return "\n".join(lines) + "\n"
+
+    @app.post("/v1/chat/completions")
+    async def chat(request: Request):
+        if fe.ready != fe.args.dp:
+            return JSONResponse({"error": {"message": "engine loading"}}, status_code=503)
+        body = await request.json()
+        prompt_ids = await asyncio.to_thread(fe.render_prompt, body)
+        max_tokens = body.get("max_completion_tokens") or body.get("max_tokens") or 4096
+        if len(prompt_ids) + 1 > fe.args.max_model_len:
+            return JSONResponse({"error": {"message": f"prompt has {len(prompt_ids)} tokens > max_model_len"}}, status_code=400)
+        max_tokens = max(1, min(int(max_tokens), fe.args.max_model_len - len(prompt_ids)))
+        sampling = dict(
+            temperature=float(body.get("temperature", 1.0)),
+            top_p=float(body.get("top_p", 1.0)),
+            ignore_eos=bool(body.get("ignore_eos", False)),
+            max_tokens=max_tokens,
+        )
+        if body.get("seed") is not None:
+            sampling["seq_seed"] = int(body["seed"])
+        fe.stats["prompt_tokens"] += len(prompt_ids)
+        include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+        key = fe.affinity_key(body)
+
+        # Register with the CE rank first so the transfer can be admitted as soon as it lands.
+        rid = uuid.uuid4().hex[:16]
+        rank = (
+            int.from_bytes(key[:4], "little") % fe.args.dp
+            if (fe.args.routing == "affinity" and key)
+            else min(range(fe.args.dp), key=lambda r: fe.load[r])
+        )
+        fe.load[rank] += 1
+        fe.owner[rid] = rank
+        q: asyncio.Queue = asyncio.Queue()
+        fe.streams[rid] = q
+        fe.stats["requests"] += 1
+        fe.in_qs[rank].put(("expect", rid, {"prompt_token_ids": prompt_ids, "sampling": sampling}))
+
+        created = int(time.time())
+        cid = f"chatcmpl-{rid}"
+        detok = oas.IncrementalDetokenizer(fe.tokenizer)
+
+        def chunk(delta: dict, finish: str | None = None, usage: dict | None = None) -> str:
+            obj = {
+                "id": cid,
+                "object": "chat.completion.chunk",
+                "created": created,
+                "model": fe.model_name,
+                "choices": [] if usage else [{"index": 0, "delta": delta, "finish_reason": finish}],
+            }
+            if usage:
+                obj["usage"] = usage
+            return f"data: {json.dumps(obj, ensure_ascii=False)}\n\n"
+
+        async def prefill_first():
+            r = await client.post(
+                f"{pe_url}/prefill",
+                json={
+                    "rid": rid,
+                    "prompt_token_ids": prompt_ids,
+                    "sampling": sampling,
+                    "kv_target": [kv_host, fe.args.kv_port + rank],
+                    "affinity": key.hex() if key else None,
+                },
+            )
+            if r.status_code != 200:
+                raise RuntimeError(f"PE: {r.text[:200]}")
+            return int(r.json()["first_token"])
+
+        async def tokens():
+            first = await prefill_first()
+            text = detok.add(first)
+            fe.stats["completion_tokens"] += 1
+            if max_tokens == 1 or first == fe.tokenizer.eos_token_id and not sampling["ignore_eos"]:
+                yield text, ("length" if max_tokens == 1 else "stop")
+                return
+            yield text, None
+            while True:
+                item = await q.get()
+                if item[0] == "error":
+                    raise RuntimeError(item[1])
+                _, token_id, finished, reason, _ = item
+                text = detok.add(token_id)
+                fe.stats["completion_tokens"] += 1
+                if finished:
+                    yield text, ("length" if detok.num_tokens >= max_tokens else "stop")
+                    return
+                yield text, None
+
+        usage = lambda: {
+            "prompt_tokens": len(prompt_ids),
+            "completion_tokens": detok.num_tokens,  # noqa: E731
+            "total_tokens": len(prompt_ids) + detok.num_tokens,
+        }
+
+        if body.get("stream"):
+
+            async def sse():
+                done = False
+                try:
+                    yield chunk({"role": "assistant", "content": ""})
+                    async for text, finish in tokens():  # noqa: B007  (the last finish reason is reported below)
+                        if text or finish:
+                            yield chunk({"content": text} if text else {}, finish)
+                    done = True
+                    if include_usage:
+                        yield chunk({}, usage=usage())
+                    yield "data: [DONE]\n\n"
+                finally:
+                    fe.release(rid, aborted=not done)
+
+            return StreamingResponse(sse(), media_type="text/event-stream")
+
+        done = False
+        try:
+            parts, finish = [], None
+            async for text, finish in tokens():  # noqa: B007  (the last finish reason is reported below)
+                parts.append(text)
+            done = True
+        finally:
+            fe.release(rid, aborted=not done)
+        return {
+            "id": cid,
+            "object": "chat.completion",
+            "created": created,
+            "model": fe.model_name,
+            "choices": [{"index": 0, "message": {"role": "assistant", "content": "".join(parts)}, "finish_reason": finish}],
+            "usage": usage(),
+        }
+
+    return app
+
+
+def main() -> None:
+    args = parse_args()
+    args.model = str(Path(args.model).expanduser().resolve())
+    os.environ.setdefault("WORLD_SIZE", "1")
+    os.environ.setdefault("RANK", "0")
+    fe = PDFrontend(args)
+    fe.start()
+    import uvicorn
+
+    if args.role == "pe":
+        app = build_pe_app(fe)
+    else:
+        assert args.pe_url, "--pe-url is required for the decode tray"
+        app = build_ce_app(fe, args.pe_url.rstrip("/"), args.kv_host or socket.gethostname())
+    uvicorn.run(app, host=args.host, port=args.port, log_level="warning", timeout_keep_alive=900)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/serve/server.sh b/serve/server.sh
new file mode 100755
index 0000000..b612fd2
--- /dev/null
+++ b/serve/server.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# Start/stop serve/openai_server.py as one process group, so stopping it also reaps the
+# engine's helper processes (otherwise they outlive the frontend and keep the GPUs).
+#
+#   serve/server.sh start [openai_server.py args...]
+#   serve/server.sh stop
+set -euo pipefail
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+PIDFILE="$ROOT/serve/server.pgid"
+LOG="${LOG:-$ROOT/serve.log}"
+
+case "${1:-}" in
+    start)
+        shift
+        [ -s "$PIDFILE" ] && kill -0 -- "-$(cat "$PIDFILE")" 2>/dev/null && { echo "already running (pgid $(cat "$PIDFILE"))" >&2; exit 1; }
+        [ -f "$ROOT/env.sh" ] && source "$ROOT/env.sh"  # optional local environment (venv, DEEPINFER_* vars)
+        : "${DEEPINFER_HF_MODEL_DIR:?set DEEPINFER_HF_MODEL_DIR to the local checkpoint directory}"
+        export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"
+        setsid python -u "$ROOT/serve/openai_server.py" --model "$DEEPINFER_HF_MODEL_DIR" \
+            --served-model-name deepseek-ai/DeepSeek-V4.1-Flash-1017 "$@" > "$LOG" 2>&1 < /dev/null &
+        echo $! > "$PIDFILE"
+        port=8888 prev=
+        for a in "$@"; do [[ "$prev" == --port ]] && port=$a; prev=$a; done
+        until curl -fs "localhost:$port/health" >/dev/null 2>&1; do
+            kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { echo "server died; see $LOG" >&2; exit 1; }
+            sleep 3
+        done
+        echo "ready (pgid $(cat "$PIDFILE"), log $LOG)"
+        ;;
+    stop)
+        [ -s "$PIDFILE" ] || { echo "not running"; exit 0; }
+        pgid=$(cat "$PIDFILE")
+        kill -TERM -- "-$pgid" 2>/dev/null || true
+        for _ in $(seq 30); do kill -0 -- "-$pgid" 2>/dev/null || break; sleep 1; done
+        kill -KILL -- "-$pgid" 2>/dev/null || true
+        rm -f "$PIDFILE"
+        echo "stopped"
+        ;;
+    *)
+        echo "usage: $0 start|stop" >&2; exit 2 ;;
+esac
diff --git a/tests/hicache/test_host_cache.py b/tests/hicache/test_host_cache.py
new file mode 100644
index 0000000..77ffc4e
--- /dev/null
+++ b/tests/hicache/test_host_cache.py
@@ -0,0 +1,190 @@
+"""HostPrefixCache logic against a fake engine: hashing/matching, the keep-tokens cap, snapping to a stored
+state, store dedupe, LRU eviction and deferral. The real state slice kernels are replaced by plain copies;
+the page transfer kernel is the real one. Needs one GPU."""
+
+from __future__ import annotations
+
+import os
+
+import numpy as np
+import pytest
+import torch
+
+os.environ["DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE"] = "compact"
+os.environ["DEEPINFER_YOCO_PREFILL_KEEP_TOKENS"] = "140"
+os.environ["DEEPINFER_PREFILL_STORE_EXTRA_STATE"] = "1"
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+
+PAGE = 114048
+STATE = 4096
+BLOCK = 128
+
+
+class FakeSeq:
+    def __init__(self, request_id: str, tokens: np.ndarray) -> None:
+        self.request_id = request_id
+        self.tokens = tokens
+        self.block_table: list[int] = []
+        self.state_id = -1
+        self.num_cached_tokens = 0
+        self.cached_hit_tokens = 0
+        self.chunked_rest_len = 0
+        self.data = self  # SequenceData stand-in
+
+    def get_len(self) -> int:
+        return len(self.tokens)
+
+    def get_token_ids(self) -> list[int]:
+        return self.tokens.tolist()
+
+
+class FakeScheduler:
+    def __init__(self, num_blocks: int, num_states: int) -> None:
+        self.free_blocks = list(range(num_blocks))
+        self.free_states = list(range(num_states))
+        self.refuse = False
+
+    def try_allocate_seq(self, seq: FakeSeq) -> bool:
+        n = (len(seq.tokens) + BLOCK - 1) // BLOCK
+        if self.refuse or len(self.free_blocks) < n or not self.free_states:
+            return False
+        seq.block_table = [self.free_blocks.pop(0) for _ in range(n)]
+        seq.state_id = self.free_states.pop(0)
+        return True
+
+    def get_num_unfinished_seqs(self) -> int:
+        return 0
+
+
+class _Obj:
+    pass
+
+
+@pytest.fixture
+def engine(monkeypatch):
+    from deepinfer.worker.cache_engine import GPUCacheInterface
+
+    monkeypatch.setattr(GPUCacheInterface, "cache_info_ready", True, raising=False)
+    monkeypatch.setattr(GPUCacheInterface, "state_size_to_disk", STATE, raising=False)
+    monkeypatch.setattr(GPUCacheInterface, "swa_block_size_kvstore", 134 + 512 + 140, raising=False)
+    monkeypatch.setattr(GPUCacheInterface, "swa_block_size_inference", 134, raising=False)
+    monkeypatch.setattr(
+        GPUCacheInterface,
+        "select_state_slice_to_store",
+        classmethod(lambda cls, sid, pos, cache, state_tensor=None, TO_CE=False: state_tensor.copy_(cache[sid, :STATE])),
+    )
+    monkeypatch.setattr(
+        GPUCacheInterface,
+        "load_state_from_store_to_prefill_cache",
+        classmethod(lambda cls, sid, pos, tensor, cache: cache[sid, :STATE].copy_(tensor)),
+    )
+    e = _Obj()
+    e.scheduler = FakeScheduler(num_blocks=512, num_states=8)
+    e.cache_config = _Obj()
+    e.cache_config.block_size = BLOCK
+    e.driver_worker = _Obj()
+    e.driver_worker.cache_engine = _Obj()
+    e.driver_worker.cache_engine.gpu_blocks = torch.zeros((512, PAGE), dtype=torch.uint8, device="cuda")
+    e.driver_worker.cache_engine.gpu_states = torch.zeros((8, STATE), dtype=torch.uint8, device="cuda")
+    return e
+
+
+def _prefill(engine, cache, seq: FakeSeq) -> None:
+    """Simulate the engine: allocate (if the cache did not), write random KV/state, run the store hook."""
+    if not seq.block_table:
+        assert engine.scheduler.try_allocate_seq(seq)
+    blocks = engine.driver_worker.cache_engine.gpu_blocks
+    states = engine.driver_worker.cache_engine.gpu_states
+    start = seq.num_cached_tokens // BLOCK
+    for b in seq.block_table[start:]:
+        blocks[b] = torch.randint(0, 256, (PAGE,), dtype=torch.uint8, device="cuda")
+    states[seq.state_id] = torch.randint(0, 256, (STATE,), dtype=torch.uint8, device="cuda")
+    cache.on_prefill_step([seq], [])
+    torch.cuda.synchronize()
+    cache.poll()
+
+
+def _tokens(n: int, seed: int) -> np.ndarray:
+    return np.random.default_rng(seed).integers(0, 100000, n, dtype=np.int32)
+
+
+def test_hit_snaps_to_stored_state_and_restores_bytes(engine):
+    from deepinfer.hicache import HostPrefixCache
+
+    cache = HostPrefixCache(engine, size_bytes=50 * PAGE, num_state_slots=8)
+    blocks = engine.driver_worker.cache_engine.gpu_blocks
+    states = engine.driver_worker.cache_engine.gpu_states
+
+    a = FakeSeq("a", _tokens(1000, 1))
+    assert cache.try_resume(a, "a", a.tokens) == 0  # cold
+    _prefill(engine, cache, a)
+    # 896 tokens = 7 pages; states at the last 4 boundaries (896, 768, 640, 512)
+    assert cache.stats.stores == 1 and cache.stats.pages_stored == 7 and cache.stats.states_stored == 4
+    a_pages = [blocks[b].clone() for b in a.block_table[:7]]
+    a_state = states[a.state_id, :STATE].clone()
+
+    # Same prefix plus a new turn: hit at 896 (= 7 full pages, and >= keep_tokens remain to recompute).
+    b = FakeSeq("b", np.concatenate([a.tokens, _tokens(500, 2)]))
+    assert cache.try_resume(b, "b", b.tokens) == 896
+    torch.cuda.synchronize()
+    cache.poll()
+    assert b.num_cached_tokens == 896 and b.cached_hit_tokens == 896
+    assert all(torch.equal(blocks[b.block_table[i]], a_pages[i]) for i in range(7))
+    assert torch.equal(states[b.state_id, :STATE], a_state)
+    assert cache.stats.hits == 1 and cache.stats.hit_tokens == 896
+
+    # Same 950-token prefix but a different tail at 1000 tokens: pages match up to 896, the keep cap allows
+    # only 768, and a state exists there -> hit at 768 (the lookback states make short extensions hit).
+    c = FakeSeq("c", np.concatenate([a.tokens[:950], _tokens(50, 3)]))
+    assert cache.try_resume(c, "c", c.tokens) == 768
+    torch.cuda.synchronize()
+    cache.poll()
+    _prefill(engine, cache, c)  # pages 0..6 and all four states already exist: nothing new is stored
+    assert cache.stats.stores == 1 and cache.stats.pages_stored == 7 and cache.stats.states_stored == 4
+
+    # b's prefill stores its remaining pages (1500 -> 11 pages, 4 new) and states at 1408..1024.
+    _prefill(engine, cache, b)
+    assert cache.stats.pages_stored == 11 and cache.stats.states_stored == 8
+    d = FakeSeq("d", np.concatenate([b.tokens, _tokens(300, 4)]))
+    assert cache.try_resume(d, "d", d.tokens) == 1408
+
+
+def test_eviction_and_capacity(engine):
+    from deepinfer.hicache import HostPrefixCache
+
+    cache = HostPrefixCache(engine, size_bytes=50 * PAGE, num_state_slots=2)
+    a = FakeSeq("a", _tokens(7 * BLOCK + 10, 1))
+    _prefill(engine, cache, a)
+    assert len(cache.pages) == 7
+
+    big = FakeSeq("big", _tokens(60 * BLOCK, 2))  # does not fit at all
+    _prefill(engine, cache, big)
+    assert cache.stats.store_skipped == 1 and len(cache.pages) == 7
+
+    e = FakeSeq("e", _tokens(40 * BLOCK, 3))  # fits without eviction (43 free)
+    _prefill(engine, cache, e)
+    assert cache.stats.evicted_pages == 0 and len(cache.pages) == 47
+
+    f = FakeSeq("f", _tokens(20 * BLOCK, 4))  # needs 20, 3 free -> evict 17 LRU pages (a's 7 first)
+    _prefill(engine, cache, f)
+    assert cache.stats.evicted_pages == 17 and len(cache.pages) == 50
+    assert (
+        cache.try_resume(FakeSeq("a2", np.concatenate([a.tokens, _tokens(300, 5)])), "a2", np.concatenate([a.tokens, _tokens(300, 5)])) == 0
+    )
+    # Only two state slots: each store keeps the two newest boundaries that fit, evicting LRU (a's, then e's).
+    assert len(cache.states) == 2 and cache.stats.evicted_states == 4
+
+
+def test_deferred_when_gpu_cannot_allocate(engine):
+    from deepinfer.hicache import HostPrefixCache
+
+    cache = HostPrefixCache(engine, size_bytes=50 * PAGE, num_state_slots=2)
+    a = FakeSeq("a", _tokens(1000, 1))
+    _prefill(engine, cache, a)
+    engine.scheduler.refuse = True
+    b = FakeSeq("b", np.concatenate([a.tokens, _tokens(500, 2)]))
+    assert cache.try_resume(b, "b", b.tokens) == -1
+    assert b.block_table == [] and b.num_cached_tokens == 0 and cache.stats.deferred == 1
+    engine.scheduler.refuse = False
+    assert cache.try_resume(b, "b", b.tokens) == 896
