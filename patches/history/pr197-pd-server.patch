@@ -0,0 +1,9 @@
+#include <torch/extension.h>
+
+void copy_pages(int64_t src_base, int64_t dst_base, torch::Tensor src_ids, torch::Tensor dst_ids, int64_t page_bytes);
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("copy_pages", &copy_pages, py::arg("src_base"), py::arg("dst_base"), py::arg("src_ids"), py::arg("dst_ids"),
+        py::arg("page_bytes"),
+        "Copy pages src_base[src_ids[i]] -> dst_base[dst_ids[i]] on the current CUDA stream. Either base may be pinned host memory.");
+}
diff --git a/deepinfer/hicache/page_copy.cu b/deepinfer/hicache/page_copy.cu
new file mode 100644
index 0000000..a445421
--- /dev/null
+++ b/deepinfer/hicache/page_copy.cu
@@ -0,0 +1,45 @@
+// Page copy between two pools addressed by UVA pointers: either pool may live in GPU memory or in
+// pinned host memory (the "kernel" transfer method of SGLang's HiCache). One thread block (row of the
+// grid) per page; pages are copied as 16-byte vectors on the current CUDA stream.
+#include <torch/extension.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+
+namespace {
+
+__global__ void copy_pages_kernel(const uint8_t *__restrict__ src_base, uint8_t *__restrict__ dst_base,
+    const int32_t *__restrict__ src_ids, const int32_t *__restrict__ dst_ids, int64_t page_bytes) {
+    const int64_t n16 = page_bytes >> 4;
+    const int4 *src = reinterpret_cast<const int4 *>(src_base + static_cast<int64_t>(src_ids[blockIdx.x]) * page_bytes);
+    int4 *dst = reinterpret_cast<int4 *>(dst_base + static_cast<int64_t>(dst_ids[blockIdx.x]) * page_bytes);
+    const int64_t stride = static_cast<int64_t>(gridDim.y) * blockDim.x;
+    for (int64_t i = static_cast<int64_t>(blockIdx.y) * blockDim.x + threadIdx.x; i < n16; i += stride) {
+        dst[i] = src[i];
+    }
+}
+
+} // namespace
+
+void copy_pages(int64_t src_base, int64_t dst_base, torch::Tensor src_ids, torch::Tensor dst_ids, int64_t page_bytes) {
+    TORCH_CHECK(page_bytes > 0 && page_bytes % 16 == 0, "page_bytes must be a positive multiple of 16, got ", page_bytes);
+    TORCH_CHECK(src_ids.is_cuda() && dst_ids.is_cuda(), "page ids must be CUDA tensors");
+    TORCH_CHECK(src_ids.scalar_type() == torch::kInt32 && dst_ids.scalar_type() == torch::kInt32, "page ids must be int32");
+    TORCH_CHECK(src_ids.is_contiguous() && dst_ids.is_contiguous(), "page ids must be contiguous");
+    TORCH_CHECK(src_ids.numel() == dst_ids.numel(), "src/dst page id count mismatch");
+    const int64_t n = src_ids.numel();
+    if (n == 0) {
+        return;
+    }
+    constexpr int threads = 256;
+    const int64_t n16 = page_bytes / 16;
+    const unsigned blocks_y = static_cast<unsigned>(std::min<int64_t>((n16 + threads - 1) / threads, 16));
+    const dim3 grid(static_cast<unsigned>(n), blocks_y);
+    auto stream = c10::cuda::getCurrentCUDAStream();
+    copy_pages_kernel<<<grid, threads, 0, stream.stream()>>>(reinterpret_cast<const uint8_t *>(src_base),
+        reinterpret_cast<uint8_t *>(dst_base), src_ids.data_ptr<int32_t>(), dst_ids.data_ptr<int32_t>(), page_bytes);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/deepinfer/hicache/pd_transfer.py b/deepinfer/hicache/pd_transfer.py
new file mode 100644
index 0000000..abc69e1
--- /dev/null
+++ b/deepinfer/hicache/pd_transfer.py
@@ -0,0 +1,125 @@
+"""Prefill/decode split: move a prefilled sequence's KV blocks and SWA state between engines.
+
+The prefill engine (EngineType.PROMPT) exports, after the last prefill chunk, the sequence's full KV blocks
+(all tokens of the prompt) and the complete SWA/compression state in the "to CE" layout
+(GPUCacheInterface.select_state_slice_to_store(..., TO_CE=True)), both into pinned host buffers through the
+page-copy kernel. The decode engine (EngineType.COMPLETION) receives those bytes into pinned buffers, allocates
+blocks and a state slot for a new sequence (prompt + first sampled token), fills them with the kernel, and admits
+the sequence into its `prompted` queue (Scheduler.add_prompted_sequence). Transport between the two is left to
+the caller (plain TCP in serve/pd_server.py).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from deepinfer import envs
+from deepinfer.hicache.kernels import copy_pages_module
+from deepinfer.worker.cache_engine import GPUCacheInterface
+
+if TYPE_CHECKING:
+    from deepinfer._C.engine import Sequence
+    from deepinfer.engine.llm_engine import LLMEngine
+
+
+def load_state_from_ce_transfer(state_id: int, last_position: int, state_tensor: torch.Tensor, state_cache: torch.Tensor) -> None:
+    """Inverse of select_state_slice_to_store(..., TO_CE=True): write a full inference-layout state (stored SWA,
+    dropped/consumer SWA and compression state) into state_cache[state_id] with the ring ending at last_position."""
+    from deepinfer.model_executor.layers.tilelang_ops.state_cache import load_state_to_cache
+
+    cls = GPUCacheInterface
+    cache_views, tensor_views = cls._carve_state_views(state_id, state_cache, state_tensor, TO_CE=True)
+    for tensor_view, cache_view in zip(tensor_views, cache_views, strict=True):
+        if tensor_view.numel():
+            load_state_to_cache(tensor_view, cache_view, last_position)
+    dropped_tensor_offset = cls.swa_total_bytes_inference_pad
+    dropped_cache_offset = cls.swa_total_bytes_kvstore_pad
+    compress_bytes = cls.dropped_bytes_inference - cls.swa_drop_total_bytes_inference_pad
+    if compress_bytes:
+        state_cache[state_id, dropped_cache_offset : dropped_cache_offset + compress_bytes].copy_(
+            state_tensor[dropped_tensor_offset : dropped_tensor_offset + compress_bytes]
+        )
+
+
+class PDTransfer:
+    """Per-engine helper owning the GPU pools' pointers and small pinned staging for transfers."""
+
+    def __init__(self, engine: LLMEngine) -> None:
+        cache_engine = engine.driver_worker.cache_engine
+        self.engine = engine
+        self.gpu_blocks: torch.Tensor = cache_engine.gpu_blocks
+        self.gpu_states: torch.Tensor = cache_engine.gpu_states
+        self.device = self.gpu_blocks.device
+        self.block_size: int = engine.cache_config.block_size
+        self.page_bytes: int = self.gpu_blocks.size(1)
+        self.state_bytes: int = GPUCacheInterface.total_bytes_inference  # full "to CE" state
+        assert self.page_bytes % 16 == 0 and self.state_bytes % 16 == 0
+        self.kernel = copy_pages_module()
+
+    def _ids(self, ids: list[int]) -> torch.Tensor:
+        return torch.tensor(ids, dtype=torch.int32).pin_memory().to(self.device, non_blocking=True)
+
+    # ---------------------------------------------------------------- prefill side
+
+    def export(self, seq: Sequence, prompt_len: int | None = None) -> tuple[torch.Tensor, torch.Tensor, torch.cuda.Event]:
+        """Copy seq's KV blocks for its prompt and the full state to pinned host buffers.
+
+        prompt_len: tokens with KV (default: seq.get_len() - 1, i.e. after the first output token was appended;
+        pass seq.get_len() when called before outputs are processed). KV exists for the prompt only, so a prompt
+        ending exactly on a block boundary must not count an extra block.
+        Returns (pages[num_blocks, page_bytes] pinned, state[state_bytes] pinned, event); the buffers are valid once
+        the event has completed. Enqueued on the current stream, so it is ordered after the prefill's kernels.
+        """
+        if prompt_len is None:
+            prompt_len = seq.get_len() - 1
+        num_blocks = (prompt_len + self.block_size - 1) // self.block_size
+        block_table = list(seq.block_table)[:num_blocks]
+        pages = torch.empty((num_blocks, self.page_bytes), dtype=torch.uint8, pin_memory=True)
+        self.kernel.copy_pages(
+            self.gpu_blocks.data_ptr(), pages.data_ptr(), self._ids(block_table), self._ids(list(range(num_blocks))), self.page_bytes
+        )
+        state = torch.empty(self.state_bytes, dtype=torch.uint8, pin_memory=True)
+        staging = torch.empty(self.state_bytes, dtype=torch.uint8, device=self.device)
+        GPUCacheInterface.select_state_slice_to_store(seq.state_id, prompt_len, self.gpu_states, state_tensor=staging, TO_CE=True)
+        self.kernel.copy_pages(staging.data_ptr(), state.data_ptr(), self._ids([0]), self._ids([0]), self.state_bytes)
+        ev = torch.cuda.Event()
+        ev.record()
+        # keep the staging alive until the copy ran (same-stream ordering makes later reuse safe)
+        ev.staging = staging  # type: ignore[attr-defined]
+        return pages, state, ev
+
+    # ---------------------------------------------------------------- decode side
+
+    def admit(self, seq: Sequence, pages: torch.Tensor, state: torch.Tensor, prompt_len: int) -> torch.cuda.Event:
+        """Fill a freshly created sequence (prompt + first token, created with add_request(enqueue=False)) from
+        pinned buffers and put it in the scheduler's prompted queue. Caller must have called try_allocate_seq.
+
+        prompt_len: tokens with KV in `pages` (= seq.get_len() - 1); the state ring ends there.
+        """
+        num_blocks = pages.size(0)
+        block_table = list(seq.block_table)
+        assert len(block_table) >= num_blocks, (len(block_table), num_blocks)
+        self.kernel.copy_pages(
+            pages.data_ptr(),
+            self.gpu_blocks.data_ptr(),
+            self._ids(list(range(num_blocks))),
+            self._ids(block_table[:num_blocks]),
+            self.page_bytes,
+        )
+        staging = torch.empty(self.state_bytes, dtype=torch.uint8, device=self.device)
+        self.kernel.copy_pages(state.data_ptr(), staging.data_ptr(), self._ids([0]), self._ids([0]), self.state_bytes)
+        load_state_from_ce_transfer(seq.state_id, prompt_len, staging, self.gpu_states)
+        seq.num_cached_tokens = prompt_len
+        seq.cached_hit_tokens = prompt_len
+        # A finished prefill leaves `nextn` draft tokens on the sequence (pad tokens when the prompt step produced
+        # none, as a prompt-only engine does); the decode sampler requires exactly that many.
+        nextn = int(envs.DEEPINFER_USE_NEXTN_DECODE)
+        if nextn > 0:
+            seq.last_next_n_token = self.engine.get_nextn_pad_token_ids().tolist()[:nextn]
+        self.engine.scheduler.add_prompted_sequence(seq)
+        ev = torch.cuda.Event()
+        ev.record()
+        ev.staging = staging  # type: ignore[attr-defined]
+        return ev
diff --git a/serve/README.md b/serve/README.md
new file mode 100644
index 0000000..a362759
--- /dev/null
+++ b/serve/README.md
@@ -0,0 +1,63 @@
+# Serving DeepInfer + host prefix cache (local additions, not part of upstream)
+
+## Pieces
+
+- `serve/openai_server.py` — OpenAI-compatible `/v1/chat/completions` (streaming, `tools`, usage) on top of the
+  offline engine: one engine process per GPU (attention DP + MoE EP), prompts rendered with the checkpoint's own
+  `encoding.py`. `serve/server.sh start|stop` runs it as a process group (stop reaps the engine helpers, which
+  otherwise keep the GPUs).
+- `deepinfer/hicache/` — host-memory prefix cache (SGLang HiCache style): pinned host pools organized in pages
+  (one page = one 128-token KV block) plus SWA state slots, hash-chain index, LRU eviction, write-through at the
+  end of every prefill, "kernel" transfers (a CUDA kernel copying pages through UVA pointers on the engine
+  stream, `page_copy.cu`, JIT-built on first use). Needs the read-only `Sequence.block_table` binding added in
+  `csrc/engine/pybind_sequence.cpp` (rebuild `deepinfer._C` with `bash scripts/build.sh build`).
+- `tests/hicache/test_host_cache.py` — cache logic against a fake engine (needs one GPU).
+- `serve/check_prefix_cache.py` — A/B on a live server: each turn sent with `"prefix_cache": false` and with
+  the cache, greedy; compares outputs and TTFT.
+
+## Run
+
+```bash
+export DEEPINFER_ACCELERATOR=nvidia DEEPINFER_HF_MODEL_DIR=/path/to/DeepSeek-V4.1-Flash-1017
+serve/server.sh start --dp 4 --port 8888                       # cache on: 32 GiB pages + 4096 states per rank
+serve/server.sh start --dp 4 --port 8888 --hicache-size-gb 0   # cache off
+python serve/check_prefix_cache.py --port 8888 --turns 3
+curl -s localhost:8888/deepinfer/metrics | grep hicache         # per-rank hit/store counters
+serve/server.sh stop
+```
+
+Knobs: `--hicache-size-gb`, `--hicache-state-slots`, `--routing affinity|least-loaded` (affinity keeps a
+conversation's turns on one rank, keyed by the first user message; required for hits since the cache is
+per rank). The cache requires decoder bounded replay (`--yoco-keep-tokens > 0`, the default 140).
+
+## How a hit works
+
+A new prompt's page hashes are matched from the start; the match is capped so that at least `keep_tokens`
+tokens remain to be recomputed (the decoder SWA state is rebuilt from that suffix by bounded replay), then
+snapped down to the nearest 128-aligned position that has a stored SWA state. The sequence is allocated up
+front, pages and state are copied in on the engine stream, `num_cached_tokens` is set, and the sequence is
+enqueued; the scheduler prefills only the suffix. Generated tokens are not stored at decode end (they are
+stored when they come back as part of the next turn's prompt).
+
+## AgentX
+
+The server speaks what InferenceX's AgentX replay (aiperf, `--endpoint /v1/chat/completions --streaming
+--use-server-token-count`) needs; `prefill-any-interval` matters there, since a single lane keeps most ranks idle.
+
+## Prefill/decode split (`pd_server.py`)
+
+`serve/pd_server.py` runs the same OpenAI-compatible frontend over two engines on two hosts: a prompt-only
+engine (PE, `--role pe`, host prefix cache on) and a decode-only engine (CE, `--role ce`, user-facing).
+Per request the CE frontend renders the prompt, picks a CE rank and POSTs `/prefill` to the PE; the PE
+prefills, exports the sequence's KV blocks and SWA state (`deepinfer/hicache/pd_transfer.py`) plus the first
+sampled token, pushes the bytes to the CE rank over TCP and the CE admits the sequence straight into decode
+(`Scheduler.add_prompted_sequence`).
+
+```bash
+serve/pd_run.sh start <pe-host> <ce-host>          # PE HTTP 8889, CE HTTP 8888, CE KV receivers 8900+rank
+python serve/check_pd.py --ref http://<single-engine-host>:8888 --pd http://<ce-host>:8888   # token-identical?
+serve/pd_run.sh stop  <pe-host> <ce-host>
+```
+
+`serve/nccl_xtray_test.py` reports the transport and bandwidth NCCL picks between the two hosts.
+Results on 4+4 GB300 vs a single 4-GPU tray: `doc/benchmark_gb300.md`.
