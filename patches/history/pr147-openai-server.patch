@@ -0,0 +1,1376 @@
+"""Minimal OpenAI-compatible chat server on top of the DeepInfer offline engine.
+
+DeepInfer ships offline inference only. This wraps one `LLM` per data-parallel rank
+(attention DP + MoE EP, same layout as examples/benchmark.py) behind a FastAPI frontend
+so request-replay benchmarks such as InferenceX AgentX (aiperf) can drive it.
+
+    python serve/openai_server.py --model ~/models/DeepSeek-V4.1-Flash-1017 --dp 4 --port 8888
+
+Protocol layer: request conversion, prompt rendering and output parsing come from `deepseek-recipe`,
+the official Rust implementation of DeepSeek's protocol stack (vendored in this image, `import
+deepseek_recipe`). A request becomes a `Conversation`; the conversation is rendered and encoded into
+token ids; the engine's token ids go back through a `StreamProcessor` that emits the protocol's own
+chunks. That is the same code DeepSeek serves with, so the prompt bytes, the DSML parser and the
+tool-call streaming are not a reimplementation. `--protocol-layer builtin` keeps the older hand-written
+layer for A/B; `tools/recipe_parity.py` asserts both agree on prompt text, token ids and parsed calls.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import base64
+import collections
+import hashlib
+import io
+import json
+import math
+import multiprocessing as mp
+import os
+import queue
+import sys
+import threading
+import time
+import urllib.request
+import uuid
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+# Module level so FastAPI can resolve the string annotation `request: Request`.
+from fastapi import FastAPI, Request
+
+if TYPE_CHECKING:
+    from deepinfer._C.engine import Sequence
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO_ROOT / "examples"))
+
+
+# --------------------------------------------------------------------------- image input
+_MAX_IMAGE_BYTES = 64 << 20
+_IMAGE_URL_TIMEOUT_S = 20
+
+
+def _messages_have_images(messages: list[dict]) -> bool:
+    for m in messages:
+        content = m.get("content")
+        if isinstance(content, list) and any(
+            isinstance(b, dict) and b.get("type") in ("image", "image_url") for b in content
+        ):
+            return True
+    return False
+
+
+def _fetch_image(url: str, allow_urls: bool) -> bytes:
+    """Bytes behind a non-data image URL. Disabled by default: this endpoint has no auth, and fetching
+    arbitrary URLs would turn it into an SSRF proxy. `--allow-image-urls` opts in."""
+    if not allow_urls:
+        raise ValueError(
+            "image URLs are disabled; send the image inline as a base64 data: URL, "
+            "or start the server with --allow-image-urls"
+        )
+    if url.startswith(("http://", "https://")):
+        with urllib.request.urlopen(url, timeout=_IMAGE_URL_TIMEOUT_S) as response:  # noqa: S310
+            data = response.read(_MAX_IMAGE_BYTES + 1)
+    else:
+        with open(url, "rb") as handle:  # local path
+            data = handle.read(_MAX_IMAGE_BYTES + 1)
+    if len(data) > _MAX_IMAGE_BYTES:
+        raise ValueError(f"image exceeds {_MAX_IMAGE_BYTES >> 20} MiB")
+    return data
+
+
+def _load_image_bytes(record: dict, allow_urls: bool) -> bytes:
+    """Bytes of one image record produced by `encoding.encode_messages(..., return_multi_modal_data=True)`."""
+    data = record.get("data")
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str) and data:
+        return base64.b64decode(data.split(",", 1)[1] if data.startswith("data:") else data)
+    source = record.get("source")
+    if isinstance(source, dict):
+        if source.get("data"):
+            return base64.b64decode(source["data"])
+        if source.get("url"):
+            return _fetch_image(source["url"], allow_urls)
+    url = record.get("url") or ""
+    if not url:
+        raise ValueError("image block has no data/source/url")
+    if url.startswith("data:"):
+        header, _, payload = url.partition(",")
+        if ";base64" not in header:
+            raise ValueError("image data URL must be base64 encoded")
+        return base64.b64decode(payload)
+    return _fetch_image(url, allow_urls)
+
+
+def _image_token_count(width: int, height: int, vision: dict) -> int:
+    """How many prompt tokens one image expands to. Faithful port of
+    `deepinfer.ve.processor.image_processor.compute_image_layout` (kept local so the frontend does not
+    import torch before the workers pin their GPUs)."""
+    patch = int(vision["patch_size"])
+    downsample = int(vision["downsample_ratio"])
+    max_n_token = int(vision["max_image_tokens"])
+    min_pixels = int(vision.get("min_pixels") or 0)
+    max_wh_ratio = vision.get("max_wh_ratio")
+
+    if max_wh_ratio is not None and width > height * max_wh_ratio:
+        width = height * max_wh_ratio
+    pixels = width * height
+    if 0 < pixels < min_pixels:
+        ratio = (min_pixels / pixels) ** 0.5
+        width, height = int(width * ratio), int(height * ratio)
+
+    best_width = math.ceil(width / patch) * patch
+    best_height = math.ceil(height / patch) * patch
+
+    def grid(h: int, w: int) -> tuple[int, int]:
+        return math.ceil((h // patch) / downsample), math.ceil((w // patch) / downsample)
+
+    def tokens(n_h: int, n_w: int) -> int:
+        return n_h * (n_w + 1) + 2
+
+    n_h, n_w = grid(best_height, best_width)
+    if tokens(n_h, n_w) > max_n_token:
+        ratio = height / width
+        max_w = math.sqrt((max_n_token - 2) / ratio + 0.25) - 0.5
+        max_h = max_w * ratio
+        cell = patch * downsample
+        if max_w < 1.0:
+            best_height, best_width = (max_n_token - 2) // 2 * cell, cell
+        elif max_h < 1.0:
+            best_height, best_width = cell, (max_n_token - 3) * cell
+        else:
+            beta = min(math.floor(max_w) * cell / width, math.floor(max_h) * cell / height)
+            best_height = math.floor(height * beta / patch) * patch
+            best_width = math.floor(width * beta / patch) * patch
+        n_h, n_w = grid(best_height, best_width)
+    return tokens(n_h, n_w)
+
+
+def _resolve_images(records: list[dict], vision: dict, allow_urls: bool) -> tuple[dict | None, int]:
+    """Engine-side `multi_modal_data` plus the number of prompt tokens the images expand to."""
+    if not records:
+        return None, 0
+    from PIL import Image  # lazy: text-only traffic never pays for it
+
+    Image.MAX_IMAGE_PIXELS = None
+    image_bytes, image_sizes, total = [], [], 0
+    for record in records:
+        data = _load_image_bytes(record, allow_urls)
+        with Image.open(io.BytesIO(data)) as img:
+            width, height = img.size
+        image_bytes.append(data)
+        image_sizes.append((width, height))
+        total += _image_token_count(width, height, vision)
+    return {"image_bytes": image_bytes, "image_sizes": image_sizes}, total
+
+
+# --------------------------------------------------------------------------- protocol layer
+try:  # shipped in this image; --protocol-layer builtin is the fallback path
+    import deepseek_recipe as dr
+except ImportError:  # pragma: no cover - only when the wheel is absent
+    dr = None
+
+
+def _checkpoint_image_token(model_dir: Path) -> str:
+    """The checkpoint's own spelling of the image placeholder.
+
+    Only the token id reaches the model (129264 here); the spelling is a tokenizer fact. V4.1-1017 calls
+    it `<｜deepseek_image｜>` while the released recipe writes `<｜image｜>`, so read the spelling back from
+    the checkpoint's tokenizer.json and hand that to recipe. A mismatch is silent corruption - the
+    placeholder would encode as text and the image would never reach the vision encoder.
+    """
+    default = dr.SpecialToken.Image.default_str()
+    try:
+        added = json.loads((model_dir / "tokenizer.json").read_text()).get("added_tokens") or []
+    except (OSError, ValueError):
+        return default
+    for entry in added:
+        if entry.get("id") == dr.IMAGE_SPECIAL_TOKEN_ID and entry.get("content"):
+            return entry["content"]
+    return default
+
+
+def _image_records(messages: list[dict]) -> list[dict]:
+    """Image records in prompt order - the order recipe numbers its placeholders in.
+
+    Mirrors the checkpoint's `encoding._extract_image`: an OpenAI block carries `image_url.url`, an
+    Anthropic block carries `source`, and a `tool_result` may nest further blocks. Returning the raw block
+    would lose the nesting (`_load_image_bytes` looks for a flat `data`/`source`/`url`).
+    """
+    records: list[dict] = []
+
+    def walk(blocks: Any) -> None:
+        if not isinstance(blocks, list):
+            return
+        for block in blocks:
+            if not isinstance(block, dict):
+                continue
+            kind = block.get("type")
+            if kind in ("image", "image_url"):
+                record: dict = {"type": "image"}
+                if kind == "image_url":
+                    image_url = block.get("image_url")
+                    record["url"] = (
+                        image_url if isinstance(image_url, str) else (image_url or {}).get("url", "")
+                    )
+                else:
+                    for key in ("source", "url", "data"):
+                        if key in block:
+                            record[key] = block[key]
+                records.append(record)
+            elif kind == "tool_result":
+                walk(block.get("content"))
+
+    for message in messages:
+        walk(message.get("content"))
+    return records
+
+
+class _Prepared:
+    """One request converted, rendered and encoded: everything the engine and the parser need."""
+
+    __slots__ = ("protocol", "converted", "prompt_ids", "multi_modal", "image_tokens", "max_tokens")
+
+    def __init__(self, protocol, converted, prompt_ids, multi_modal, image_tokens, max_tokens) -> None:
+        self.protocol = protocol
+        self.converted = converted
+        self.prompt_ids = prompt_ids
+        self.multi_modal = multi_modal
+        self.image_tokens = image_tokens
+        self.max_tokens = max_tokens
+
+    @property
+    def stream(self) -> bool:
+        return bool(self.converted.stream)
+
+
+def _finish_reason(reason: str | None, generated: int, max_tokens: int):
+    """Map the engine's stop reason onto the parser's; the parser overrides it with `tool_calls`."""
+    if "length" in str(reason or "").lower() or generated >= max_tokens:
+        return dr.InferenceFinishReason.Length
+    return dr.InferenceFinishReason.Stop
+
+
+async def recipe_response(fe: Frontend, protocol: str, body: dict):
+    """Serve one request through deepseek-recipe: convert -> render -> encode -> engine -> parse."""
+    from fastapi.responses import JSONResponse, Response, StreamingResponse
+
+    if fe.ready != fe.args.num_engines:
+        return JSONResponse({"error": {"message": "engine loading"}}, status_code=503)
+    try:
+        prepared = await asyncio.to_thread(fe.prepare, protocol, body)
+    except dr.ConversionError as exc:
+        return Response(content=exc.body, status_code=exc.status_code, media_type="application/json")
+    except Exception as exc:  # noqa: BLE001 - bad request shapes and undecodable images land here
+        return JSONResponse(
+            {"error": {"message": str(exc), "type": "invalid_request_error"}}, status_code=400
+        )
+
+    prompt_len = len(prepared.prompt_ids) + prepared.image_tokens
+    include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+    fe.stats["prompt_tokens"] += prompt_len
+    # Non-standard request field: "prefix_cache": false bypasses the host prefix cache lookup (A/B checks).
+    rid, q = fe.submit(
+        prepared.prompt_ids,
+        fe.sampling(body, prepared),
+        fe.affinity_key(body),
+        use_cache=bool(body.get("prefix_cache", True)),
+        multi_modal=prepared.multi_modal,
+    )
+    fe.req_meta[rid] = (prepared.stream, include_usage, prompt_len, prepared.multi_modal is not None)
+
+    request_type, response_type = fe.request_types[protocol]
+    response_id = f"{protocol.split('_')[0]}-{rid}"
+    generator = request_type.chunk_generator(prepared.converted, response_id, fe.model_name)
+    processor = dr.StreamProcessor(generator, prepared.converted.parsing_options, tokenizer=fe.rtok)
+    created = int(time.time())
+    generated = 0
+
+    async def outputs():
+        """Engine token ids in, protocol chunks out (usage included)."""
+        nonlocal generated
+        announced = False
+        while True:
+            item = await q.get()
+            if item[0] == "error":
+                raise RuntimeError(item[1])
+            _, token_id, finished, reason, _ = item
+            if not announced:
+                # The worker puts the cache-hit size on the queue before the first token, so it is
+                # settled by now. Reporting it up front is what fills prompt_tokens_details.cached_tokens.
+                announced = True
+                ready = dr.InferenceChunk.ready(
+                    prompt_usage=dr.PromptUsage(
+                        prompt_tokens=prompt_len,
+                        prompt_cache_hit_tokens=fe.cached.get(rid, 0),
+                    )
+                )
+                for out in processor.push(ready):
+                    yield out
+            if token_id is not None and token_id != fe.eos_token_id:
+                generated += 1
+                fe.stats["completion_tokens"] += 1
+                for out in processor.push(dr.InferenceChunk.tokens([token_id])):
+                    yield out
+            if finished:
+                finish = _finish_reason(reason, generated, prepared.max_tokens)
+                for out in processor.push(dr.InferenceChunk.finish(finish)):
+                    yield out
+                for out in processor.finish():
+                    yield out
+                return
+
+    def close(aborted: bool) -> None:
+        fe.release(rid, aborted=aborted)
+        processor.close()
+        if aborted:
+            fe.stats["errors"] += 1
+
+    if prepared.stream:
+
+        async def sse():
+            done = False
+            try:
+                async for out in outputs():
+                    event = response_type.sse_event_name(out)
+                    prefix = f"event: {event}\n" if event is not None else ""
+                    yield f"{prefix}data: {out.to_json()}\n\n"
+                done = True
+            finally:
+                close(aborted=not done)
+            tail = response_type.sse_done_data()
+            if tail is not None:
+                yield f"data: {tail}\n\n"
+
+        return StreamingResponse(sse(), media_type="text/event-stream")
+
+    done = False
+    response = response_type(response_id, fe.model_name, created, 0, 0)
+    try:
+        async for out in outputs():
+            response.accumulate(out)
+        done = True
+    finally:
+        close(aborted=not done)
+    return Response(content=response.to_json(), media_type="application/json")
+
+
+async def count_tokens_response(fe: Frontend, body: dict):
+    """`/v1/messages/count_tokens`: convert, render and encode the request, report the prompt size."""
+    from fastapi.responses import JSONResponse, Response
+
+    try:
+        count = await asyncio.to_thread(fe.count_tokens, body)
+    except dr.ConversionError as exc:
+        return Response(content=exc.body, status_code=exc.status_code, media_type="application/json")
+    except Exception as exc:  # noqa: BLE001 - bad request shapes land here
+        return JSONResponse(
+            {"error": {"message": str(exc), "type": "invalid_request_error"}}, status_code=400
+        )
+    return JSONResponse({"input_tokens": count})
+
+
+class _ToolCallGate:
+    """Withhold the tail of a stream until it is clear whether a DSML tool-call block has started.
+
+    The model writes tool calls as markup in the text stream. Forwarding that verbatim is what made a
+    Claude client print `<|DSML| calls>` instead of running a tool, so the block is buffered and turned into
+    structured `tool_calls` at the end. Only a tail as long as the block marker is ever withheld, so normal
+    streaming is unaffected.
+
+    The marker is `<|DSML|` on its own, not `\\n\\n<|DSML| calls`: the checkpoint's streaming parser matches
+    `NewlinesAndMarker` (zero or more newlines, then the marker) while the offline splitter asserts the exact
+    `\\n\\n` layout it was trained on. A turn that starts with a tool call, or one wrapped in a single
+    newline, is well formed for the model but would otherwise leak raw markup to the client.
+    """
+
+    def __init__(self, marker: str) -> None:
+        self.marker = marker
+        self.pending = ""
+        self.block = ""
+        self.gated = False
+
+    def _withheld(self, text: str) -> int:
+        """Bytes to keep back: enough of a partial marker to decide on the next feed, plus the
+        newline run directly in front of it (the block's lead-in, which `split_tool_calls` strips
+        from the content)."""
+        j = max(0, len(text) - (len(self.marker) - 1))
+        while j > 0 and text[j - 1] == "\n":
+            j -= 1
+        return len(text) - j
+
+    def feed(self, text: str) -> str:
+        if self.gated:
+            self.block += text
+            return ""
+        self.pending += text
+        pos = self.pending.find(self.marker)
+        if pos >= 0:
+            # The newlines in front of the marker belong to the block, not to the content.
+            out, self.block = self.pending[:pos].rstrip("\n"), self.pending[pos:]
+            self.pending, self.gated = "", True
+            return out
+        held = self._withheld(self.pending)
+        if len(self.pending) <= held:
+            return ""
+        out, self.pending = self.pending[:-held], self.pending[-held:]
+        return out
+
+    def flush(self) -> str:
+        out = "" if self.gated else self.pending
+        self.pending = ""
+        return out
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", required=True, help="local HF checkpoint directory")
+    p.add_argument("--served-model-name", default=None)
+    p.add_argument("--dp", type=int, default=4, help="expert-parallel size on this node (= GPUs used)")
+    p.add_argument(
+        "--cp",
+        type=int,
+        default=1,
+        help="context-parallel size: GPUs cooperating on one engine. dp // cp engines are started; "
+        "cp > 1 shards a sequence across GPUs, which is what makes long-context prefill fast "
+        "(see notes/18: 1M TTFT is 20 s at cp=8 vs 189 s at cp=1 on 8x H20-3e)",
+    )
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8888)
+    p.add_argument("--max-model-len", type=int, default=1 << 20)
+    p.add_argument("--max-num-seqs", type=int, default=128, help="per DP rank")
+    p.add_argument("--max-num-batched-tokens", type=int, default=32768, help="prefill chunk per DP rank")
+    p.add_argument("--gpu-memory-utilization", type=float, default=0.9)
+    p.add_argument("--yoco-keep-tokens", type=int, default=140, help="0 disables decoder SWA bounded replay")
+    p.add_argument("--thinking-mode", default="chat", choices=["chat", "thinking"])
+    p.add_argument(
+        "--protocol-layer",
+        default="recipe",
+        choices=["recipe", "builtin"],
+        help="recipe: deepseek-recipe converts the request, renders/encodes the prompt and parses the "
+        "model output (the official stack, also serves /v1/messages and /v1/responses). builtin: the "
+        "hand-written layer, kept for A/B against recipe",
+    )
+    p.add_argument(
+        "--always-usage",
+        action="store_true",
+        help="emit the usage chunk in streaming responses even when the client did not send "
+        "stream_options.include_usage. The OpenAI spec ties it to that flag, but many gateways (new-api, one-api) "
+        "only get cache/billing numbers from an upstream usage chunk and silently fall back to their own tokenizer",
+    )
+    p.add_argument(
+        "--log-requests",
+        action="store_true",
+        help="log one line per finished request (stream/include_usage/prompt/cached) so a gateway that drops "
+        "usage can be told apart from a genuine cache miss",
+    )
+    p.add_argument(
+        "--allow-image-urls",
+        action="store_true",
+        help="let image_url blocks carry http(s):// or local-path URLs (default: only inline base64 data URLs, "
+        "because this endpoint has no auth and would otherwise act as an SSRF proxy)",
+    )
+    p.add_argument("--log-interval-steps", type=int, default=200)
+    p.add_argument("--hicache-size-gb", type=float, default=32, help="pinned host KV page pool per DP rank; 0 disables the prefix cache")
+    p.add_argument("--hicache-state-slots", type=int, default=4096, help="host SWA state slots per DP rank")
+    p.add_argument(
+        "--routing",
+        default="affinity",
+        choices=["affinity", "least-loaded"],
+        help="affinity: a conversation's turns go to one rank (needed for cache hits)",
+    )
+    p.add_argument(
+        "--prefill-any-interval",
+        type=int,
+        default=2,
+        help="DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL: a rank with a waiting prompt gets a prefill step at most this "
+        "many decode steps later even if other ranks are idle (engine default 100 => ~1.4 s TTFT floor)",
+    )
+    args = p.parse_args()
+    if args.cp < 1 or args.dp < 1 or args.dp % args.cp:
+        p.error(f"--dp ({args.dp}) must be a positive multiple of --cp ({args.cp})")
+    # --dp is the EP size (= GPUs); each engine spans --cp GPUs, so the node runs dp // cp engines.
+    args.num_engines = args.dp // args.cp
+    return args
+
