--- /dev/null
+++ b/tests/distributed/test_engram_nvlink.py
@@ -0,0 +1,108 @@
+"""Correctness test for the NVLink Engram fetch against a naive all-gather reference.
+
+Run on 2 GPUs:  torchrun --nproc_per_node=2 tests/distributed/test_engram_nvlink.py
+
+Covers what the fast path can silently get wrong:
+  * rows owned locally vs remotely,
+  * layer tables of different sizes (the `rank * num_entries` offset),
+  * ranks that hold a *different* number of tokens in the same step (data-parallel replicas),
+  * a step far below the buffer capacity (the index-padding path),
+  * the scaling-factor gather.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.distributed as dist
+
+from deepinfer.model_executor.parallel_utils.engram_nvlink import NVLinkEngramBuffer
+
+HIDDEN = 256
+E = 24  # num_entries_per_token
+SF_PACKS = 2
+ENTRIES_PER_LAYER = [1000, 1296]
+
+_ = torch.manual_seed
+
+
+def random_fp8_rows(num_rows: int, rank: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(1234 + rank)
+    raw = torch.randint(0, 256, (num_rows, HIDDEN), generator=g, dtype=torch.int32).to(torch.uint8)
+    return raw.view(torch.float8_e4m3fn)
+
+
+def random_sf(num_rows: int, rank: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(999 + rank)
+    return torch.randint(-(2**31), 2**31 - 1, (num_rows, SF_PACKS), generator=g, dtype=torch.int32).cuda()
+
+
+def reference(tables: list[torch.Tensor], sfs: list[torch.Tensor], indices: torch.Tensor, world: int):
+    """Naive: one all-gather of the whole (tiny) tables, then a plain index."""
+    out_rows, out_sfs = [], []
+    for layer_idx, num_entries in enumerate(ENTRIES_PER_LAYER):
+        gathered = torch.empty((world * num_entries, HIDDEN), dtype=torch.uint8, device="cuda")
+        dist.all_gather_into_tensor(gathered, tables[layer_idx].view(torch.uint8).cuda(), group=dist.group.WORLD)
+        idx = indices[layer_idx].long()
+        out_rows.append(gathered[idx].reshape(indices.shape[1], E * HIDDEN))
+        # The scaling-factor table is replicated in full on every rank, so no gather is needed here.
+        out_sfs.append(sfs[layer_idx][idx].reshape(indices.shape[1], E * SF_PACKS))
+    return out_rows, out_sfs
+
+
+def main() -> None:
+    dist.init_process_group("nccl")
+    rank, world = dist.get_rank(), dist.get_world_size()
+    assert world == 2, "this test expects 2 ranks"
+    torch.cuda.set_device(rank)
+
+    tables = [random_fp8_rows(n, rank) for n in ENTRIES_PER_LAYER]
+    sfs = [random_sf(world * n, rank) for n in ENTRIES_PER_LAYER]  # replicated, not sharded
+
+    max_num_tokens = 64
+    buf = NVLinkEngramBuffer(dist.group.WORLD, ENTRIES_PER_LAYER, HIDDEN, max_num_tokens, E, torch.float8_e4m3fn, SF_PACKS)
+    buf.write(tables, sfs=sfs)
+
+    failures = 0
+    # Case 1: both ranks carry the same token count.
+    # Case 2: rank 1 carries fewer tokens (exercises padding up to the shared cap).
+    # Case 3: close to the buffer capacity, so the padding path is nearly empty.
+    for case, my_tokens in enumerate((6, 4, 30)):
+        g = torch.Generator().manual_seed(7 + case * 100 + rank)
+        # Each layer has its own global index space: rank r owns [r*n, (r+1)*n) of that layer.
+        idx = torch.stack([
+            torch.randint(0, world * n, (my_tokens, E), generator=g, dtype=torch.int32)
+            for n in ENTRIES_PER_LAYER
+        ])
+        # Force the data-parallel case: rank 1 asks for fewer rows than rank 0.
+        if case == 1 and rank == 1:
+            idx = idx[:, :2]
+        indices = idx.cuda()
+
+        ref_rows, ref_sfs = reference(tables, sfs, indices, world)
+        hooks = buf.fetch(indices)
+        assert len(hooks) == len(ENTRIES_PER_LAYER)
+
+        for layer_idx, hook in enumerate(hooks):
+            got_rows, got_sf = hook()
+            ok_rows = torch.equal(got_rows.view(torch.uint8), ref_rows[layer_idx].view(torch.uint8))
+            ok_sf = torch.equal(got_sf, ref_sfs[layer_idx])
+            if not (ok_rows and ok_sf):
+                failures += 1
+                print(f"[FAIL] case={case} rank={rank} layer={layer_idx} rows={ok_rows} sf={ok_sf}", flush=True)
+                if not ok_rows:
+                    bad = (got_rows.view(torch.uint8) != ref_rows[layer_idx].view(torch.uint8)).any(dim=1).nonzero().flatten()[:5]
+                    print(f"       first mismatching tokens: {bad.tolist()}", flush=True)
+                if not ok_sf:
+                    bad = (got_sf != ref_sfs[layer_idx]).any(dim=1).nonzero().flatten()[:5]
+                    print(f"       first mismatching sf tokens: {bad.tolist()}", flush=True)
+
+    total = torch.tensor([failures], dtype=torch.int32, device="cuda")
+    dist.all_reduce(total, op=dist.ReduceOp.SUM)
+    if rank == 0:
+        print(f"[test] {'PASS' if total.item() == 0 else 'FAIL'} ({total.item()} mismatching layer-cases)", flush=True)
+    dist.destroy_process_group()
+    raise SystemExit(0 if total.item() == 0 else 1)
+
+
+if __name__ == "__main__":
+    main()
