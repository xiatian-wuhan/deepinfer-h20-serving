+from fastapi import FastAPI, Request
+
+if TYPE_CHECKING:
+    from deepinfer._C.engine import Sequence
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO_ROOT / "examples"))
+
+
+# --------------------------------------------------------------------------- image input
+_MAX_IMAGE_BYTES = 64 << 20
+_IMAGE_URL_TIMEOUT_S = 20
+
+
+def _messages_have_images(messages: list[dict]) -> bool:
+    for m in messages:
+        content = m.get("content")
+        if isinstance(content, list) and any(
+            isinstance(b, dict) and b.get("type") in ("image", "image_url") for b in content
+        ):
+            return True
+    return False
+
+
+def _fetch_image(url: str, allow_urls: bool) -> bytes:
+    """Bytes behind a non-data image URL. Disabled by default: this endpoint has no auth, and fetching
+    arbitrary URLs would turn it into an SSRF proxy. `--allow-image-urls` opts in."""
+    if not allow_urls:
+        raise ValueError(
+            "image URLs are disabled; send the image inline as a base64 data: URL, "
+            "or start the server with --allow-image-urls"
+        )
+    if url.startswith(("http://", "https://")):
+        with urllib.request.urlopen(url, timeout=_IMAGE_URL_TIMEOUT_S) as response:  # noqa: S310
+            data = response.read(_MAX_IMAGE_BYTES + 1)
+    else:
+        with open(url, "rb") as handle:  # local path
+            data = handle.read(_MAX_IMAGE_BYTES + 1)
+    if len(data) > _MAX_IMAGE_BYTES:
+        raise ValueError(f"image exceeds {_MAX_IMAGE_BYTES >> 20} MiB")
+    return data
+
+
+def _load_image_bytes(record: dict, allow_urls: bool) -> bytes:
+    """Bytes of one image record produced by `encoding.encode_messages(..., return_multi_modal_data=True)`."""
+    data = record.get("data")
+    if isinstance(data, bytes):
+        return data
+    if isinstance(data, str) and data:
+        return base64.b64decode(data.split(",", 1)[1] if data.startswith("data:") else data)
+    source = record.get("source")
+    if isinstance(source, dict):
+        if source.get("data"):
+            return base64.b64decode(source["data"])
+        if source.get("url"):
+            return _fetch_image(source["url"], allow_urls)
+    url = record.get("url") or ""
+    if not url:
+        raise ValueError("image block has no data/source/url")
+    if url.startswith("data:"):
+        header, _, payload = url.partition(",")
+        if ";base64" not in header:
+            raise ValueError("image data URL must be base64 encoded")
+        return base64.b64decode(payload)
+    return _fetch_image(url, allow_urls)
+
+
+def _image_token_count(width: int, height: int, vision: dict) -> int:
+    """How many prompt tokens one image expands to. Faithful port of
+    `deepinfer.ve.processor.image_processor.compute_image_layout` (kept local so the frontend does not
+    import torch before the workers pin their GPUs)."""
+    patch = int(vision["patch_size"])
+    downsample = int(vision["downsample_ratio"])
+    max_n_token = int(vision["max_image_tokens"])
+    min_pixels = int(vision.get("min_pixels") or 0)
+    max_wh_ratio = vision.get("max_wh_ratio")
+
+    if max_wh_ratio is not None and width > height * max_wh_ratio:
+        width = height * max_wh_ratio
+    pixels = width * height
+    if 0 < pixels < min_pixels:
+        ratio = (min_pixels / pixels) ** 0.5
+        width, height = int(width * ratio), int(height * ratio)
+
+    best_width = math.ceil(width / patch) * patch
+    best_height = math.ceil(height / patch) * patch
+
+    def grid(h: int, w: int) -> tuple[int, int]:
+        return math.ceil((h // patch) / downsample), math.ceil((w // patch) / downsample)
+
+    def tokens(n_h: int, n_w: int) -> int:
+        return n_h * (n_w + 1) + 2
+
+    n_h, n_w = grid(best_height, best_width)
+    if tokens(n_h, n_w) > max_n_token:
+        ratio = height / width
+        max_w = math.sqrt((max_n_token - 2) / ratio + 0.25) - 0.5
+        max_h = max_w * ratio
+        cell = patch * downsample
+        if max_w < 1.0:
+            best_height, best_width = (max_n_token - 2) // 2 * cell, cell
+        elif max_h < 1.0:
+            best_height, best_width = cell, (max_n_token - 3) * cell
+        else:
+            beta = min(math.floor(max_w) * cell / width, math.floor(max_h) * cell / height)
+            best_height = math.floor(height * beta / patch) * patch
+            best_width = math.floor(width * beta / patch) * patch
+        n_h, n_w = grid(best_height, best_width)
+    return tokens(n_h, n_w)
+
+
+def _resolve_images(records: list[dict], vision: dict, allow_urls: bool) -> tuple[dict | None, int]:
+    """Engine-side `multi_modal_data` plus the number of prompt tokens the images expand to."""
+    if not records:
+        return None, 0
+    from PIL import Image  # lazy: text-only traffic never pays for it
+
+    Image.MAX_IMAGE_PIXELS = None
+    image_bytes, image_sizes, total = [], [], 0
+    for record in records:
+        data = _load_image_bytes(record, allow_urls)
+        with Image.open(io.BytesIO(data)) as img:
+            width, height = img.size
+        image_bytes.append(data)
+        image_sizes.append((width, height))
+        total += _image_token_count(width, height, vision)
+    return {"image_bytes": image_bytes, "image_sizes": image_sizes}, total
+
+
+# --------------------------------------------------------------------------- protocol layer
+try:  # shipped in this image; --protocol-layer builtin is the fallback path
+    import deepseek_recipe as dr
+except ImportError:  # pragma: no cover - only when the wheel is absent
+    dr = None
+
+
+def _checkpoint_image_token(model_dir: Path) -> str:
+    """The checkpoint's own spelling of the image placeholder.
+
+    Only the token id reaches the model (129264 here); the spelling is a tokenizer fact. V4.1-1017 calls
+    it `<｜deepseek_image｜>` while the released recipe writes `<｜image｜>`, so read the spelling back from
+    the checkpoint's tokenizer.json and hand that to recipe. A mismatch is silent corruption - the
+    placeholder would encode as text and the image would never reach the vision encoder.
+    """
+    default = dr.SpecialToken.Image.default_str()
+    try:
+        added = json.loads((model_dir / "tokenizer.json").read_text()).get("added_tokens") or []
+    except (OSError, ValueError):
+        return default
+    for entry in added:
+        if entry.get("id") == dr.IMAGE_SPECIAL_TOKEN_ID and entry.get("content"):
+            return entry["content"]
+    return default
+
+
+def _image_records(messages: list[dict]) -> list[dict]:
+    """Image records in prompt order - the order recipe numbers its placeholders in.
+
+    Mirrors the checkpoint's `encoding._extract_image`: an OpenAI block carries `image_url.url`, an
+    Anthropic block carries `source`, and a `tool_result` may nest further blocks. Returning the raw block
+    would lose the nesting (`_load_image_bytes` looks for a flat `data`/`source`/`url`).
+    """
+    records: list[dict] = []
+
+    def walk(blocks: Any) -> None:
+        if not isinstance(blocks, list):
+            return
+        for block in blocks:
+            if not isinstance(block, dict):
+                continue
+            kind = block.get("type")
+            if kind in ("image", "image_url"):
+                record: dict = {"type": "image"}
+                if kind == "image_url":
+                    image_url = block.get("image_url")
+                    record["url"] = (
+                        image_url if isinstance(image_url, str) else (image_url or {}).get("url", "")
+                    )
+                else:
+                    for key in ("source", "url", "data"):
+                        if key in block:
+                            record[key] = block[key]
+                records.append(record)
+            elif kind == "tool_result":
+                walk(block.get("content"))
+
+    for message in messages:
+        walk(message.get("content"))
+    return records
+
+
+class _Prepared:
+    """One request converted, rendered and encoded: everything the engine and the parser need."""
+
+    __slots__ = ("protocol", "converted", "prompt_ids", "multi_modal", "image_tokens", "max_tokens")
+
+    def __init__(self, protocol, converted, prompt_ids, multi_modal, image_tokens, max_tokens) -> None:
+        self.protocol = protocol
+        self.converted = converted
+        self.prompt_ids = prompt_ids
+        self.multi_modal = multi_modal
+        self.image_tokens = image_tokens
+        self.max_tokens = max_tokens
+
+    @property
+    def stream(self) -> bool:
+        return bool(self.converted.stream)
+
+
+def _finish_reason(reason: str | None, generated: int, max_tokens: int):
+    """Map the engine's stop reason onto the parser's; the parser overrides it with `tool_calls`."""
+    if "length" in str(reason or "").lower() or generated >= max_tokens:
+        return dr.InferenceFinishReason.Length
+    return dr.InferenceFinishReason.Stop
+
+
+async def recipe_response(fe: Frontend, protocol: str, body: dict):
+    """Serve one request through deepseek-recipe: convert -> render -> encode -> engine -> parse."""
+    from fastapi.responses import JSONResponse, Response, StreamingResponse
+
+    if fe.ready != fe.args.num_engines:
+        return JSONResponse({"error": {"message": "engine loading"}}, status_code=503)
+    try:
+        prepared = await asyncio.to_thread(fe.prepare, protocol, body)
+    except dr.ConversionError as exc:
+        return Response(content=exc.body, status_code=exc.status_code, media_type="application/json")
+    except Exception as exc:  # noqa: BLE001 - bad request shapes and undecodable images land here
+        return JSONResponse(
+            {"error": {"message": str(exc), "type": "invalid_request_error"}}, status_code=400
+        )
+
+    prompt_len = len(prepared.prompt_ids) + prepared.image_tokens
+    include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+    fe.stats["prompt_tokens"] += prompt_len
+    # Non-standard request field: "prefix_cache": false bypasses the host prefix cache lookup (A/B checks).
+    rid, q = fe.submit(
+        prepared.prompt_ids,
+        fe.sampling(body, prepared),
+        fe.affinity_key(body),
+        use_cache=bool(body.get("prefix_cache", True)),
+        multi_modal=prepared.multi_modal,
+    )
+    fe.req_meta[rid] = (prepared.stream, include_usage, prompt_len, prepared.multi_modal is not None)
+
+    request_type, response_type = fe.request_types[protocol]
+    response_id = f"{protocol.split('_')[0]}-{rid}"
+    generator = request_type.chunk_generator(prepared.converted, response_id, fe.model_name)
+    processor = dr.StreamProcessor(generator, prepared.converted.parsing_options, tokenizer=fe.rtok)
+    created = int(time.time())
+    generated = 0
+
+    async def outputs():
+        """Engine token ids in, protocol chunks out (usage included)."""
+        nonlocal generated
+        announced = False
+        while True:
+            item = await q.get()
+            if item[0] == "error":
+                raise RuntimeError(item[1])
+            _, token_id, finished, reason, _ = item
+            if not announced:
+                # The worker puts the cache-hit size on the queue before the first token, so it is
+                # settled by now. Reporting it up front is what fills prompt_tokens_details.cached_tokens.
+                announced = True
+                ready = dr.InferenceChunk.ready(
+                    prompt_usage=dr.PromptUsage(
+                        prompt_tokens=prompt_len,
+                        prompt_cache_hit_tokens=fe.cached.get(rid, 0),
+                    )
+                )
+                for out in processor.push(ready):
+                    yield out
+            if token_id is not None and token_id != fe.eos_token_id:
+                generated += 1
+                fe.stats["completion_tokens"] += 1
+                for out in processor.push(dr.InferenceChunk.tokens([token_id])):
+                    yield out
+            if finished:
+                finish = _finish_reason(reason, generated, prepared.max_tokens)
+                for out in processor.push(dr.InferenceChunk.finish(finish)):
+                    yield out
+                for out in processor.finish():
+                    yield out
+                return
+
+    def close(aborted: bool) -> None:
+        fe.release(rid, aborted=aborted)
+        processor.close()
+        if aborted:
+            fe.stats["errors"] += 1
+
+    if prepared.stream:
+
+        async def sse():
+            done = False
+            try:
+                async for out in outputs():
+                    event = response_type.sse_event_name(out)
+                    prefix = f"event: {event}\n" if event is not None else ""
+                    yield f"{prefix}data: {out.to_json()}\n\n"
+                done = True
+            finally:
+                close(aborted=not done)
+            tail = response_type.sse_done_data()
+            if tail is not None:
+                yield f"data: {tail}\n\n"
+
+        return StreamingResponse(sse(), media_type="text/event-stream")
+
+    done = False
+    response = response_type(response_id, fe.model_name, created, 0, 0)
+    try:
+        async for out in outputs():
+            response.accumulate(out)
+        done = True
+    finally:
+        close(aborted=not done)
+    return Response(content=response.to_json(), media_type="application/json")
+
+
+async def count_tokens_response(fe: Frontend, body: dict):
+    """`/v1/messages/count_tokens`: convert, render and encode the request, report the prompt size."""
+    from fastapi.responses import JSONResponse, Response
+
+    try:
+        count = await asyncio.to_thread(fe.count_tokens, body)
+    except dr.ConversionError as exc:
+        return Response(content=exc.body, status_code=exc.status_code, media_type="application/json")
+    except Exception as exc:  # noqa: BLE001 - bad request shapes land here
+        return JSONResponse(
+            {"error": {"message": str(exc), "type": "invalid_request_error"}}, status_code=400
+        )
+    return JSONResponse({"input_tokens": count})
+
+
+class _ToolCallGate:
+    """Withhold the tail of a stream until it is clear whether a DSML tool-call block has started.
+
+    The model writes tool calls as markup in the text stream. Forwarding that verbatim is what made a
+    Claude client print `<|DSML| calls>` instead of running a tool, so the block is buffered and turned into
+    structured `tool_calls` at the end. Only a tail as long as the block marker is ever withheld, so normal
+    streaming is unaffected.
+
+    The marker is `<|DSML|` on its own, not `\\n\\n<|DSML| calls`: the checkpoint's streaming parser matches
+    `NewlinesAndMarker` (zero or more newlines, then the marker) while the offline splitter asserts the exact
+    `\\n\\n` layout it was trained on. A turn that starts with a tool call, or one wrapped in a single
+    newline, is well formed for the model but would otherwise leak raw markup to the client.
+    """
+
+    def __init__(self, marker: str) -> None:
+        self.marker = marker
+        self.pending = ""
+        self.block = ""
+        self.gated = False
+
+    def _withheld(self, text: str) -> int:
+        """Bytes to keep back: enough of a partial marker to decide on the next feed, plus the
+        newline run directly in front of it (the block's lead-in, which `split_tool_calls` strips
+        from the content)."""
+        j = max(0, len(text) - (len(self.marker) - 1))
+        while j > 0 and text[j - 1] == "\n":
+            j -= 1
+        return len(text) - j
+
+    def feed(self, text: str) -> str:
+        if self.gated:
+            self.block += text
+            return ""
+        self.pending += text
+        pos = self.pending.find(self.marker)
+        if pos >= 0:
+            # The newlines in front of the marker belong to the block, not to the content.
+            out, self.block = self.pending[:pos].rstrip("\n"), self.pending[pos:]
+            self.pending, self.gated = "", True
+            return out
+        held = self._withheld(self.pending)
+        if len(self.pending) <= held:
+            return ""
+        out, self.pending = self.pending[:-held], self.pending[-held:]
+        return out
+
+    def flush(self) -> str:
+        out = "" if self.gated else self.pending
+        self.pending = ""
+        return out
+
+
+def parse_args() -> argparse.Namespace:
+    p = argparse.ArgumentParser()
+    p.add_argument("--model", required=True, help="local HF checkpoint directory")
+    p.add_argument("--served-model-name", default=None)
+    p.add_argument("--dp", type=int, default=4, help="expert-parallel size on this node (= GPUs used)")
+    p.add_argument(
+        "--cp",
+        type=int,
+        default=1,
+        help="context-parallel size: GPUs cooperating on one engine. dp // cp engines are started; "
+        "cp > 1 shards a sequence across GPUs, which is what makes long-context prefill fast "
+        "(see notes/18: 1M TTFT is 20 s at cp=8 vs 189 s at cp=1 on 8x H20-3e)",
+    )
+    p.add_argument("--host", default="0.0.0.0")
+    p.add_argument("--port", type=int, default=8888)
+    p.add_argument("--max-model-len", type=int, default=1 << 20)
+    p.add_argument("--max-num-seqs", type=int, default=128, help="per DP rank")
+    p.add_argument("--max-num-batched-tokens", type=int, default=32768, help="prefill chunk per DP rank")
+    p.add_argument("--gpu-memory-utilization", type=float, default=0.9)
+    p.add_argument("--yoco-keep-tokens", type=int, default=140, help="0 disables decoder SWA bounded replay")
+    p.add_argument("--thinking-mode", default="chat", choices=["chat", "thinking"])
+    p.add_argument(
+        "--protocol-layer",
+        default="recipe",
+        choices=["recipe", "builtin"],
+        help="recipe: deepseek-recipe converts the request, renders/encodes the prompt and parses the "
+        "model output (the official stack, also serves /v1/messages and /v1/responses). builtin: the "
+        "hand-written layer, kept for A/B against recipe",
+    )
+    p.add_argument(
+        "--always-usage",
+        action="store_true",
+        help="emit the usage chunk in streaming responses even when the client did not send "
+        "stream_options.include_usage. The OpenAI spec ties it to that flag, but many gateways (new-api, one-api) "
+        "only get cache/billing numbers from an upstream usage chunk and silently fall back to their own tokenizer",
+    )
+    p.add_argument(
+        "--log-requests",
+        action="store_true",
+        help="log one line per finished request (stream/include_usage/prompt/cached) so a gateway that drops "
+        "usage can be told apart from a genuine cache miss",
+    )
+    p.add_argument(
+        "--allow-image-urls",
+        action="store_true",
+        help="let image_url blocks carry http(s):// or local-path URLs (default: only inline base64 data URLs, "
+        "because this endpoint has no auth and would otherwise act as an SSRF proxy)",
+    )
+    p.add_argument("--log-interval-steps", type=int, default=200)
+    p.add_argument("--hicache-size-gb", type=float, default=32, help="pinned host KV page pool per DP rank; 0 disables the prefix cache")
+    p.add_argument("--hicache-state-slots", type=int, default=4096, help="host SWA state slots per DP rank")
+    p.add_argument(
+        "--routing",
+        default="affinity",
+        choices=["affinity", "least-loaded"],
+        help="affinity: a conversation's turns go to one rank (needed for cache hits)",
+    )
+    p.add_argument(
+        "--prefill-any-interval",
+        type=int,
+        default=2,
+        help="DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL: a rank with a waiting prompt gets a prefill step at most this "
+        "many decode steps later even if other ranks are idle (engine default 100 => ~1.4 s TTFT floor)",
+    )
+    args = p.parse_args()
+    if args.cp < 1 or args.dp < 1 or args.dp % args.cp:
+        p.error(f"--dp ({args.dp}) must be a positive multiple of --cp ({args.cp})")
+    # --dp is the EP size (= GPUs); each engine spans --cp GPUs, so the node runs dp // cp engines.
+    args.num_engines = args.dp // args.cp
+    return args
+
+
+# --------------------------------------------------------------------------- engine side
+
+
+def worker_main(args: argparse.Namespace, dp_rank: int, in_q: mp.Queue, out_q: mp.Queue) -> None:
+    """One DP rank: owns an engine and steps it in lockstep with the other ranks."""
+    import ctypes
+    import signal
+
+    # Die with the frontend instead of lingering as an orphan that holds the GPU.
+    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
+
+    from _config import create_llm, setup_common_env
+
+    if args.yoco_keep_tokens > 0:
+        os.environ["DEEPINFER_YOCO_PREFILL_TRUNCATION_MODE"] = "compact"
+        os.environ["DEEPINFER_YOCO_PREFILL_KEEP_TOKENS"] = str(args.yoco_keep_tokens)
+        os.environ["DEEPINFER_PREFILL_STORE_EXTRA_STATE"] = "1"
+    if args.hicache_size_gb > 0:
+        # Keep more SWA history in the state ring so the prefix cache can store states at several
+        # 128-boundaries behind the end of a prompt (see HostPrefixCache.state_lookback_blocks).
+        os.environ.setdefault("DEEPINFER_PREFILL_STORE_EXTRA_SIZE", "512")
+    os.environ.setdefault("DEEPINFER_PREFILL_ANY_ATTEMPT_INTERVAL", str(args.prefill_any_interval))
+    setup_common_env(model_name=args.model, sampler_force_topk=1024, set_override_experts=True, enable_eplb=True)
+
+    llm = create_llm(
+        args.model,
+        dp_rank,
+        ep_size=args.dp,
+        cp_size=args.cp,
+        env={"DEEPINFER_LOGGING_INTERVAL_STEP": str(args.log_interval_steps)},
+        data_parallel_size=args.num_engines,
+        max_num_seqs=args.max_num_seqs,
+        max_num_batched_tokens=args.max_num_batched_tokens,
+        max_model_len=args.max_model_len,
+        gpu_memory_utilization=args.gpu_memory_utilization,
+        # MTP draft depth handed to the scheduler. Historically pinned to min(1, ...) = 1, which
+        # leaves the checkpoint's 3 nextn heads mostly unused; DEEPINFER_SERVE_LOOKAHEAD lets that
+        # be raised for benchmarking. Default 1 keeps the shipped behaviour.
+        lookahead_tokens=min(int(os.getenv("DEEPINFER_SERVE_LOOKAHEAD", "1")),
+                             int(os.getenv("DEEPINFER_USE_NEXTN_DECODE", "5"))),
+    )
+
+    import numpy as np
+
+    from deepinfer._C.engine import RequestOutput  # pyright: ignore[reportMissingModuleSource]
+    from deepinfer.sampling_params import SamplingParams
+
+    engine = llm.llm_engine
+    cache = None
+    if args.hicache_size_gb > 0:
+        try:
+            from deepinfer.hicache import HostPrefixCache
+        except ImportError:  # tree without the host prefix cache: serve without it
+            print(f"[server] deepinfer.hicache not available, prefix cache disabled (rank {dp_rank})", flush=True)
+        else:
+            cache = HostPrefixCache(engine, size_bytes=int(args.hicache_size_gb * 2**30), num_state_slots=args.hicache_state_slots)
+            engine.pe_do_save_kvcache = cache.on_prefill_step  # write-through at the end of every prefill
+    out_q.put(("ready", dp_rank, None))
+
+    def mm_data(multi_modal: dict | None = None):
+        if engine.multi_modal_processor is None:
+            return None
+        if multi_modal:
+            return dict(image_bytes=multi_modal["image_bytes"], image_sizes=multi_modal["image_sizes"])
+        return dict(image_bytes=[], image_sizes=[])
+
+    def enqueue(rid: str, seq: Sequence, num_cached_tokens: int) -> None:
+        # Same as LLMEngine.add_request's _enqueue: the processor must get the sequence's own multimodal dict
+        # (overwrite_prompt wrote the text/image segments into it), plus the cached prefix length.
+        engine.scheduler.add_sequence(seq)
+        if engine.multi_modal_processor is not None:
+            engine.multi_modal_processor.add(rid, seq.multi_modal_data, num_cached_tokens)
+
+    pending = collections.deque()  # (rid, seq, prompt_ids, use_cache): created, waiting for a cache decision
+    inflight = False
+    last_stats = time.monotonic()
+    last_logged_lookups = 0
+    while True:
+        # Requests must be enqueued before the DP-wide has_unfinished_requests all-reduce,
+        # so every rank takes the same step / flush / idle branch in the same iteration.
+        while True:
+            try:
+                kind, rid, payload = in_q.get_nowait()
+            except queue.Empty:
+                break
+            if kind == "add":
+                try:
+                    prompt_ids = np.asarray(payload["prompt_token_ids"], dtype=np.int32)
+                    seq = engine.add_request(
+                        user_id="0",
+                        request_id=rid,
+                        sampling_params=SamplingParams(**payload["sampling"]),
+                        prompt_token_ids=prompt_ids,
+                        multi_modal_data=mm_data(payload.get("multi_modal")),
+                        enqueue=cache is None,
+                    )
+                    if cache is not None:
+                        if seq is None:
+                            out_q.put(("error", rid, "request dropped: invalid prompt tokens"))
+                        else:
+                            pending.append((rid, seq, prompt_ids, payload.get("use_cache", True)))
+                except Exception as e:  # noqa: BLE001 - surface to the client, keep the rank alive
+                    out_q.put(("error", rid, repr(e)))
+            elif kind == "abort":
+                if any(p[0] == rid for p in pending):
+                    pending = collections.deque(p for p in pending if p[0] != rid)
+                else:
+                    engine.abort_request(rid)
+                if cache is not None:
+                    cache.forget(rid)
+
+        # Cache decisions, in arrival order. A hit pre-allocates the sequence's blocks and fills them from the
+        # host; if the GPU cannot allocate yet, wait (while something is running that will free memory).
+        while pending:
+            rid, seq, prompt_ids, use_cache = pending[0]
+            hit = cache.try_resume(seq, rid, prompt_ids) if use_cache else 0
+            if hit < 0 and (engine.scheduler.get_num_unfinished_seqs() > 0 or inflight):
+                break
+            pending.popleft()
+            # Emit the resume size BEFORE any token so the frontend's FIFO sees it first and
+            # `usage.prompt_tokens_details.cached_tokens` matches what vLLM reports.
+            out_q.put(("cached", rid, max(hit, 0)))
+            enqueue(rid, seq, max(hit, 0))
+        if cache is not None:
+            cache.poll()
+            if time.monotonic() - last_stats > 5:
+                last_stats = time.monotonic()
+                st = cache.stats_dict()
+                out_q.put(("stats", dp_rank, st))
+                if st["lookups"] != last_logged_lookups:
+                    last_logged_lookups = st["lookups"]
+                    print(
+                        f"[hicache rank {dp_rank}] lookups {st['lookups']} hits {st['hits']} "
+                        f"token hit rate {st['hit_rate_tokens']:.1%} deferred {st['deferred']} stores {st['stores']} "
+                        f"pages {st['pages_used']}/{st['pages_total']} states {st['states_used']}/{st['states_total']} "
+                        f"evicted {st['evicted_pages']}",
+                        flush=True,
+                    )
+
+        if engine.has_unfinished_requests():
+            outputs = engine.step()
+            inflight = True
+        elif inflight:
+            outputs = engine.flush_inflight_reqs()
+            inflight = False
+        else:
+            time.sleep(0.001)
+            continue
+
+        if len(outputs):
+            # Pointers are recycled on the next step, so read the fields now.
+            batch = [
+                (
+                    RequestOutput.get_request_id(p),
+                    RequestOutput.get_token_id(p),
+                    RequestOutput.get_finished(p),
+                    RequestOutput.get_finish_reason(p),
+                    RequestOutput.get_prompt_len(p),
+                )
+                for p in outputs
+            ]
+            if cache is not None:
+                for rid, _, finished, _, _ in batch:
+                    if finished:
+                        cache.forget(rid)
+            out_q.put(("tokens", None, batch))
+
+
+# --------------------------------------------------------------------------- HTTP side
+
+
+class IncrementalDetokenizer:
+    """vLLM-style prefix/read offsets so each delta decodes only a short tail."""
+
+    def __init__(self, tokenizer: Any) -> None:
+        self.tok = tokenizer
+        self.ids: list[int] = []
+        self.num_tokens = 0
+        self.prefix_offset = 0
+        self.read_offset = 0
+
+    def add(self, token_id: int) -> str:
+        self.num_tokens += 1
+        if token_id == self.tok.eos_token_id:
+            return ""
+        self.ids.append(token_id)
+        prefix = self.tok.decode(self.ids[self.prefix_offset : self.read_offset], skip_special_tokens=False)
+        full = self.tok.decode(self.ids[self.prefix_offset :], skip_special_tokens=False)
+        if len(full) > len(prefix) and not full.endswith("�"):
+            self.prefix_offset, self.read_offset = self.read_offset, len(self.ids)
+            return full[len(prefix) :]
+        return ""
+
+
+class Frontend:
+    def __init__(self, args: argparse.Namespace) -> None:
+        self.args = args
+        self.model_name = args.served_model_name or args.model
+        # Vision config drives image-token accounting; absent means the checkpoint is text only.
+        vision: dict = {}
+        config_file = Path(args.model) / "config.json"
+        if config_file.is_file():
+            try:
+                vision = json.loads(config_file.read_text()).get("vision_config") or {}
+            except (OSError, ValueError):
+                vision = {}
+        self.vision = vision
+        self.has_vision = bool(vision)
+        self.protocol_layer = args.protocol_layer
+        if self.protocol_layer == "recipe" and dr is None:
+            print("[server] deepseek-recipe is not importable; using the builtin protocol layer", flush=True)
+            self.protocol_layer = "builtin"
+        if self.protocol_layer == "recipe":
+            self._init_recipe()
+        else:
+            self._init_builtin()
+        ctx = mp.get_context("spawn")
+        self.out_q: mp.Queue = ctx.Queue()
+        self.in_qs: list[mp.Queue] = [ctx.Queue() for _ in range(args.num_engines)]
+        # Not daemonic: the engine forks its own helper processes (as examples/_launch.py allows).
+        self.procs = [
+            ctx.Process(target=worker_main, args=(args, r, self.in_qs[r], self.out_q), daemon=False)
+            for r in range(args.num_engines)
+        ]
+        self.load = [0] * args.num_engines
+        self.owner: dict[str, int] = {}
+        self.streams: dict[str, asyncio.Queue] = {}
+        self.ready = 0
+        self.stats = dict(requests=0, finished=0, aborted=0, errors=0, prompt_tokens=0, completion_tokens=0, encode_fallbacks=0)
+        self.cache_stats: dict[int, dict] = {}
+        self.cached: dict[str, int] = {}
+        self.req_meta: dict[str, tuple] = {}  # rid -> (stream, include_usage, prompt_len, has_image), for --log-requests
+        self.loop: asyncio.AbstractEventLoop | None = None
+
+    def _init_builtin(self) -> None:
+        """The hand-written layer: the checkpoint's reference encoder renders, this file parses."""
+        from transformers import AutoTokenizer
+
+        sys.path.insert(0, str(Path(self.args.model) / "encoding"))
+        # The checkpoint's own prompt-format reference: it both renders `tools` into the prompt and parses
+        # the DSML block the model writes back.
+        from encoding import (
+            decode_dsml_to_arguments,
+            dsml_token,
+            encode_messages,
+            parse_tool_calls,
+            tool_calls_block_name,
+        )
+
+        self.encode_messages = encode_messages
+        self._parse_tool_calls = parse_tool_calls
+        self._decode_dsml_to_arguments = decode_dsml_to_arguments
+        self.dsml_token = dsml_token
+        self.tool_calls_marker = f"<{dsml_token}"
+        self.tool_calls_open = f"<{dsml_token}{tool_calls_block_name}"
+        self.tokenizer = AutoTokenizer.from_pretrained(self.args.model)
+
+    def _init_recipe(self) -> None:
+        """Wire `deepseek-recipe`: convert, render, encode in; parse, stream, account usage out."""
+        model_dir = Path(self.args.model)
+        specials = dr.SpecialTokens(image=_checkpoint_image_token(model_dir))
+        self.conv_options = (
+            dr.ConversionOptions()
+            .with_special_tokens(specials)
+            # The service's --thinking-mode is the default for requests that say nothing; a client that
+            # sends `thinking` or `reasoning_effort` still overrides it per request.
+            .with_default_thinking_mode(self.args.thinking_mode == "thinking")
+            .with_model_alias(self.model_name, dr.ModelVersion.DeepseekV41Flash)
+        )
+        self.rtok = dr.Tokenizer.from_file(str(model_dir / "tokenizer.json"))
+        self.encoding = dr.DeepseekV41Encoding().with_special_tokens(specials).with_tokenizer(self.rtok)
+        self.request_types = {
+            "chat_completions": (dr.ChatCompletionRequest, dr.ChatCompletionResponse),
+            "messages": (dr.MessagesRequest, dr.MessagesResponse),
+            "responses": (dr.ResponsesRequest, dr.ResponsesResponse),
+        }
+        config = {}
+        try:
+            config = json.loads((model_dir / "config.json").read_text())
+        except (OSError, ValueError):
+            pass
+        eos = config.get("eos_token_id")
+        self.eos_token_id = int(eos[0] if isinstance(eos, list) else eos or 1)
+        # `encode` runs on CPU threads; the Rust handles are shared, so serialise the conversion step.
+        self._encode_lock = threading.Lock()
+        print(
+            f"[server] protocol layer: deepseek-recipe {dr.__version__} "
+            f"(image token {specials.token(dr.SpecialToken.Image)}, eos {self.eos_token_id})",
+            flush=True,
+        )
+
+    def prepare(self, protocol: str, body: dict) -> _Prepared:
+        """Convert one protocol request into engine input. CPU work: call it from a thread."""
+        payload = dict(body)
+        # DeepSeek's Anthropic surface maps Claude model names onto its own (claude-opus* -> v4-pro,
+        # claude-sonnet*/haiku* -> flash) so that pointing Claude Code at the base_url is enough. This
+        # node serves one model, so every claude* name resolves to it; other unknown names still 400.
+        requested = str(payload.get("model") or "")
+        payload["model"] = self.model_name if requested.lower().startswith("claude") else (requested or self.model_name)
+        request_type = self.request_types[protocol][0]
+        try:
+            request = request_type(json.dumps(payload).encode())
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"invalid {protocol} request: {exc}") from exc
+        with self._encode_lock:
+            converted = request.convert(self.conv_options)
+            rendered = self.encoding.render_conversation(converted.conversation)
+            prompt_ids = self.encoding.encode(converted.conversation)
+        messages = [dict(m) for m in payload.get("messages") or []]
+        if self.args.log_requests:
+            self._log_message_order(messages)
+            self._log_prompt_order(rendered.prompt)
+        multi_modal, image_tokens = None, 0
+        if rendered.image_sources:
+            if not self.has_vision:
+                raise ValueError("this checkpoint has no vision encoder; image input is not supported")
+            records = _image_records(messages)
+            if len(records) != len(rendered.image_sources):
+                raise ValueError(
+                    f"{len(rendered.image_sources)} image placeholder(s) but {len(records)} image block(s) "
+                    f"in 'messages'; image input is only wired for the Messages/Chat Completions message list"
+                )
+            multi_modal, image_tokens = _resolve_images(records, self.vision, self.args.allow_image_urls)
+        # Images cost more prompt tokens than the single placeholder each occupies in `prompt_ids`.
+        prompt_len = len(prompt_ids) + image_tokens
+        max_tokens = converted.resolve_max_tokens(prompt_len, self.args.max_model_len)
+        return _Prepared(protocol, converted, prompt_ids, multi_modal, image_tokens, max_tokens)
+
+    def count_tokens(self, body: dict) -> int:
+        """Prompt size of a Messages request, for `/v1/messages/count_tokens`.
+
+        That request carries no `max_tokens` (the endpoint only measures), so supply one and throw the
+        rest of the conversion away. Images are counted at what the vision encoder expands them to,
+        which is what the model actually reads.
+        """
+        payload = dict(body)
+        payload["max_tokens"] = 1
+        payload["stream"] = False
+        prepared = self.prepare("messages", payload)
+        return len(prepared.prompt_ids) + prepared.image_tokens
+
+    @staticmethod
+    def sampling(body: dict, prepared: _Prepared) -> dict:
+        """The engine's sampler settings, taken from the request.
+
+        `deepseek-recipe` also reports `InferenceOptions`, but it deliberately resolves V4.1's `top_p` to
+        1.0 outside thinking mode and drops `top_k`/penalties; a client that sets them expects them to
+        apply, so the wire values win here and the recipe values are only used for `max_tokens`.
+        """
+        sampling = dict(
+            temperature=float(body.get("temperature", 1.0)),
+            top_p=float(body.get("top_p", 1.0)),
+            top_k=int(body.get("top_k", -1)),
+            ignore_eos=bool(body.get("ignore_eos", False)),
+            max_tokens=int(prepared.max_tokens),
+        )
+        if body.get("seed") is not None:
+            sampling["seq_seed"] = int(body["seed"])
+        return sampling
+
+    def start(self) -> None:
+        for p in self.procs:
+            p.start()
+
+    def dispatch_forever(self) -> None:
+        """Thread: fan engine outputs out to the per-request asyncio queues."""
+        while True:
+            try:
+                kind, rid, payload = self.out_q.get(timeout=1.0)
+            except queue.Empty:
+                dead = [r for r, p in enumerate(self.procs) if not p.is_alive()]
+                if dead:
+                    print(f"[server] engine rank(s) {dead} died; failing open requests and exiting", flush=True)
+                    for rid in list(self.streams):
+                        self.loop.call_soon_threadsafe(self._deliver, rid, ("error", f"engine rank died: {dead}"))
+                    time.sleep(2)
+                    os._exit(1)
+                continue
+            if kind == "ready":
+                self.ready += 1
+                print(f"[server] engine {rid} ready ({self.ready}/{self.args.num_engines})", flush=True)
+            elif kind == "error":
+                self.loop.call_soon_threadsafe(self._deliver, rid, ("error", payload))
+            elif kind == "stats":
+                self.cache_stats[rid] = payload
+            elif kind == "cached":
+                self.cached[rid] = payload
+            else:
+                self.loop.call_soon_threadsafe(self._deliver_batch, payload)
+
+    def _deliver(self, rid: str, item: tuple) -> None:
+        q = self.streams.get(rid)
+        if q is not None:
+            q.put_nowait(item)
+
+    def _deliver_batch(self, batch: list[tuple]) -> None:
+        for rid, token_id, finished, reason, prompt_len in batch:
+            q = self.streams.get(rid)
+            if q is not None:
+                q.put_nowait(("token", token_id, finished, reason, prompt_len))
+
+    def render_prompt(self, body: dict) -> tuple[list[int], dict | None, int]:
+        """Token ids, the engine's `multi_modal_data` (None when text only), and how many prompt tokens the
+        images expand to (the placeholder each image occupies is replaced by the vision encoder's tokens)."""
+        messages = [dict(m) for m in body["messages"]]
+        if body.get("tools"):
+            if not messages or messages[0].get("role") != "system":
+                messages.insert(0, {"role": "system", "content": ""})
+            messages[0]["tools"] = body["tools"]
+        if self.args.log_requests:
+            self._log_message_order(messages)
+        has_images = _messages_have_images(messages)
+        if has_images and not self.has_vision:
+            raise ValueError("this checkpoint has no vision encoder; image input is not supported")
+        multi_modal, image_tokens = None, 0
+        try:
+            prompt, media = self.encode_messages(
+                messages,
+                thinking_mode=self.args.thinking_mode,
+                return_multi_modal_data=True,
+            )
+            multi_modal, image_tokens = _resolve_images(
+                media.get("images") or [], self.vision, self.args.allow_image_urls
+            )
+            if self.args.log_requests:
+                self._log_prompt_order(prompt)
+        except Exception as exc:  # noqa: BLE001 - the reference encoder rejects some traces
+            # Never degrade an image request to a text-only prompt: that silently drops the image.
+            if has_images:
+                raise ValueError(f"cannot encode the image request: {exc}") from exc
+            self.stats["encode_fallbacks"] += 1
+            parts = ["<｜begin▁of▁sentence｜>"]
+            for m in messages:
+                content = m.get("content") or ""
+                if isinstance(content, list):
+                    content = "".join(b.get("text", "") for b in content if isinstance(b, dict))
+                if m.get("tool_calls"):
+                    content += json.dumps(m["tool_calls"], ensure_ascii=False)
+                tag = {"user": "<｜User｜>", "assistant": "<｜Assistant｜>", "tool": "<｜User｜>"}.get(m.get("role"), "")
+                parts.append(tag + content)
+            if body.get("tools"):
+                parts.insert(1, json.dumps(body["tools"], ensure_ascii=False))
+            prompt = "".join(parts) + "<｜Assistant｜></think>"
+        return self.tokenizer.encode(prompt, add_special_tokens=False), multi_modal, image_tokens
+
+    def _log_message_order(self, messages: list[dict]) -> None:
+        """Compact transcript digest: role order, content sizes, tool-call ids.
+
+        A gateway that reorders history is otherwise invisible from here - the model just answers the
+        wrong turn - so this prints what actually arrived, in order.
+        """
+        parts = []
+        for m in messages:
+            role = m.get("role", "?")
+            content = m.get("content")
+            size = len(content) if isinstance(content, str) else (len(json.dumps(content)) if content else 0)
+            tag = f"{role}:{size}"
+            calls = m.get("tool_calls") or []
+            if calls:
+                tag += "(" + ",".join(str(c.get("id", "?")) for c in calls) + ")"
+            if m.get("tool_call_id"):
+                tag += f"->{m['tool_call_id']}"
+            parts.append(tag)
+        print(f"[msgs] in={' | '.join(parts)}", flush=True)
+
+    def _log_prompt_order(self, prompt: str) -> None:
+        """Speaker tags in the order the model will read them."""
+        seq, i = [], 0
+        while True:
+            user_at = prompt.find("<｜User｜>", i)
+            asst_at = prompt.find("<｜Assistant｜>", i)
+            if user_at < 0 and asst_at < 0:
+                break
+            if user_at >= 0 and (asst_at < 0 or user_at < asst_at):
+                seq.append("U")
+                i = user_at + 1
+            else:
+                seq.append("A")
+                i = asst_at + 1
+        print(f"[msgs] out={''.join(seq)}", flush=True)
+
+    def split_tool_calls(self, text: str) -> tuple[str, list[dict]]:
+        """Strip a trailing DSML tool-call block and return it as OpenAI `tool_calls`.
+
+        Malformed markup (for example a block cut off by max_tokens) is left in the text rather than
+        dropping it or failing the request.
+        """
+        start = text.find(self.tool_calls_marker)
+        while start >= 0 and not text.startswith(self.tool_calls_open, start):
+            start = text.find(self.tool_calls_marker, start + 1)
+        if start < 0:
+            return text, []
+        block = text[start:]
+        calls: list[dict] | None = None
+        try:
+            _, _, calls = self._parse_tool_calls(len(self.tool_calls_open), block)
+        except Exception as exc:  # noqa: BLE001 - the reference splitter asserts an exact layout
+            calls = self.tolerant_tool_calls(block)
+            if calls is None and self.args.log_requests:
+                print(f"[tools] DSML parse failed, passing the text through: {exc}", flush=True)
+        if calls is None:
+            return text, []
+        content = text[:start].rstrip("\n")
+        if not calls:
+            return content, []
+        converted = [
+            {
+                "id": f"call_{uuid.uuid4().hex[:24]}",
+                "type": "function",
+                "function": {"name": call["name"], "arguments": call["arguments"]},
+            }
+            for call in calls
+        ]
+        return content, converted
+
+    def tolerant_tool_calls(self, block: str) -> list[dict] | None:
+        """Second chance for a block the reference splitter rejects on layout.
+
+        `encoding.parse_tool_calls` asserts the exact `>\\n` shape the model is trained to emit and raises on
+        anything else; the checkpoint's streaming parser (deepseek-recipe `output_parser.rs`) instead matches
+        `invoke name="` / `parameter name=` literally and skips whatever whitespace sits between them
+        (`Stage::ToolCalls => ActionOnUnmatched::Skip`). Mirroring that here keeps a near-miss readable as a
+        tool call instead of leaking the raw markup into `content`. Returns None when the block really is not
+        parseable (truncated, or a foreign tag).
+        """
+        d = self.dsml_token
+        invoke_open = f'<{d} invoke name="'
+        invoke_close = f"</{d} invoke>"
+        param_open = f'<{d} parameter name="'
+        param_close = f"</{d} parameter>"
+        calls: list[dict] = []
+        cursor = 0
+        while True:
+            at = block.find(invoke_open, cursor)
+            if at < 0:
+                return calls
+            name_start = at + len(invoke_open)
+            name_end = block.find('"', name_start)
+            if name_end < 0:
+                return None
+            name = block[name_start:name_end]
+            args: dict[str, tuple[str, str]] = {}
+            cursor = name_end
+            while True:
+                param_at = block.find(param_open, cursor)
+                end_at = block.find(invoke_close, cursor)
+                if end_at < 0:
+                    return None
+                if param_at < 0 or param_at > end_at:
+                    cursor = end_at + len(invoke_close)
+                    break
+                key_start = param_at + len(param_open)
+                key_end = block.find('"', key_start)
+                if key_end < 0:
+                    return None
+                key = block[key_start:key_end]
+                after_key = key_end + 1  # step over the closing quote of the parameter name
+                flag_prefix = ' string="'
+                if not block.startswith(flag_prefix, after_key):
+                    return None
+                flag_start = after_key + len(flag_prefix)
+                flag_end = block.find('"', flag_start)
+                if flag_end < 0 or block[flag_start:flag_end] not in ("true", "false"):
+                    return None
+                if not block.startswith(">", flag_end + 1):
+                    return None
+                value_start = flag_end + 2
+                value_end = block.find(param_close, value_start)
+                if value_end < 0:
+                    return None
+                args[key] = (block[value_start:value_end], block[flag_start:flag_end])
+                cursor = value_end + len(param_close)
+            calls.append(self._decode_dsml_to_arguments(name, args))
+
+    @staticmethod
+    def affinity_key(body: dict) -> bytes | None:
+        """Stable per-conversation key: the first user message (AgentX's cache-bust marker lives there and is
+        constant across a trajectory's turns, and forked subagents inherit it)."""
+        for m in body.get("messages", []):
+            if m.get("role") == "user":
+                content = m.get("content") or ""
+                if isinstance(content, list):
+                    content = "".join(b.get("text", "") for b in content if isinstance(b, dict))
+                return hashlib.sha1(content[:4096].encode("utf-8", "ignore")).digest()
+        return None
+
+    def submit(
+        self,
+        prompt_ids: list[int],
+        sampling: dict,
+        key: bytes | None = None,
+        use_cache: bool = True,
+        multi_modal: dict | None = None,
+    ) -> tuple[str, asyncio.Queue]:
+        rid = uuid.uuid4().hex
+        if self.args.routing == "affinity" and key is not None:
+            rank = int.from_bytes(key[:4], "little") % self.args.num_engines
+        else:
+            rank = min(range(self.args.num_engines), key=lambda r: self.load[r])
+        self.load[rank] += 1
+        self.owner[rid] = rank
+        q: asyncio.Queue = asyncio.Queue()
+        self.streams[rid] = q
+        self.stats["requests"] += 1
+        self.in_qs[rank].put(
+            (
+                "add",
+                rid,
+                {
+                    "prompt_token_ids": prompt_ids,
+                    "sampling": sampling,
+                    "use_cache": use_cache,
+                    "multi_modal": multi_modal,
+                },
+            )
+        )
+        return rid, q
+
+    def release(self, rid: str, aborted: bool) -> None:
+        rank = self.owner.pop(rid, None)
+        self.streams.pop(rid, None)
+        meta = self.req_meta.pop(rid, None)
+        cached = self.cached.pop(rid, 0)
+        if self.args.log_requests and meta is not None:
+            stream, include_usage, prompt_len, has_image = meta
+            print(
+                f"[req] rid={rid[:8]} stream={int(stream)} include_usage={int(include_usage)} "
+                f"images={int(has_image)} prompt={prompt_len} cached={cached} aborted={int(aborted)}",
+                flush=True,
+            )
+        if rank is None:
+            return
+        self.load[rank] -= 1
+        if aborted:
+            self.stats["aborted"] += 1
+            self.in_qs[rank].put(("abort", rid, None))
+        else:
+            self.stats["finished"] += 1
+
+
+def build_app(fe: Frontend) -> FastAPI:
+    from fastapi import FastAPI
+    from fastapi.responses import JSONResponse, PlainTextResponse, StreamingResponse
+
+    app = FastAPI()
+
+    @app.on_event("startup")
+    async def _startup() -> None:
+        fe.loop = asyncio.get_running_loop()
+        threading.Thread(target=fe.dispatch_forever, daemon=True).start()
+
+    @app.get("/health")
+    async def health():
+        ok = fe.ready == fe.args.num_engines
+        return JSONResponse({"status": "ok" if ok else "loading", "ready_ranks": fe.ready}, status_code=200 if ok else 503)
+
+    @app.get("/v1/models")
+    async def models():
+        return {"object": "list", "data": [{"id": fe.model_name, "object": "model", "owned_by": "deepinfer"}]}
+
+    # Not at /metrics: aiperf scrapes that path automatically and InferenceX's aggregator
+    # rejects metric families it has no backend adapter for.
+    @app.get("/deepinfer/metrics")
+    async def metrics():
+        lines = [f"deepinfer:{k}_total {v}" for k, v in fe.stats.items()]
+        lines += [f'deepinfer:num_requests_running{{dp_rank="{r}"}} {n}' for r, n in enumerate(fe.load)]
+        for r, st in sorted(fe.cache_stats.items()):
+            lines += [f'deepinfer_hicache:{k}{{dp_rank="{r}"}} {v}' for k, v in st.items()]
+        return PlainTextResponse("\n".join(lines) + "\n")
+
+    @app.post("/v1/chat/completions")
+    async def chat(request: Request):
+        if fe.protocol_layer == "recipe":
+            return await recipe_response(fe, "chat_completions", await request.json())
+        if fe.ready != fe.args.num_engines:
+            return JSONResponse({"error": {"message": "engine loading"}}, status_code=503)
+        body = await request.json()
+        try:
+            prompt_ids, multi_modal, image_tokens = await asyncio.to_thread(fe.render_prompt, body)
+        except Exception as exc:  # noqa: BLE001 - bad request shapes and undecodable images land here
+            return JSONResponse(
+                {"error": {"message": str(exc), "type": "invalid_request_error"}}, status_code=400
+            )
+        # Images cost more prompt tokens than the single placeholder each occupies in `prompt_ids`.
+        prompt_len = len(prompt_ids) + image_tokens
+        max_tokens = body.get("max_completion_tokens") or body.get("max_tokens") or 4096
+        if prompt_len + 1 > fe.args.max_model_len:
+            return JSONResponse({"error": {"message": f"prompt has {prompt_len} tokens > max_model_len"}}, status_code=400)
+        max_tokens = max(1, min(int(max_tokens), fe.args.max_model_len - prompt_len))
+        sampling = dict(
+            temperature=float(body.get("temperature", 1.0)),
+            top_p=float(body.get("top_p", 1.0)),
+            ignore_eos=bool(body.get("ignore_eos", False)),
+            max_tokens=max_tokens,
+        )
+        if body.get("seed") is not None:
+            sampling["seq_seed"] = int(body["seed"])
+        fe.stats["prompt_tokens"] += prompt_len
+        include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+        # Non-standard request field: "prefix_cache": false bypasses the host prefix cache lookup (A/B checks).
+        rid, q = fe.submit(
+            prompt_ids,
+            sampling,
+            fe.affinity_key(body),
+            use_cache=bool(body.get("prefix_cache", True)),
+            multi_modal=multi_modal,
+        )
+        fe.req_meta[rid] = (bool(body.get("stream")), include_usage, prompt_len, multi_modal is not None)
+        created = int(time.time())
+        cid = f"chatcmpl-{rid}"
+        detok = IncrementalDetokenizer(fe.tokenizer)
+
+        def chunk(delta: dict, finish: str | None = None, usage: dict | None = None) -> str:
+            obj = {
+                "id": cid,
+                "object": "chat.completion.chunk",
+                "created": created,
+                "model": fe.model_name,
+                "choices": [] if usage else [{"index": 0, "delta": delta, "finish_reason": finish}],
+            }
+            if usage:
+                obj["usage"] = usage
+            return f"data: {json.dumps(obj, ensure_ascii=False)}\n\n"
+
+        async def tokens():
+            """Yield (text_delta, finish_reason) until the request finishes."""
+            while True:
+                item = await q.get()
+                if item[0] == "error":
+                    raise RuntimeError(item[1])
+                _, token_id, finished, reason, _ = item
+                text = detok.add(token_id)
+                fe.stats["completion_tokens"] += 1
+                if finished:
+                    yield text, ("length" if detok.num_tokens >= max_tokens else "stop")
+                    return
+                yield text, None
+
+        def usage(cached_tokens: int | None = None) -> dict:
+            # vLLM returns prompt_tokens_details.cached_tokens; agents/gateways read it to compute
+            # cache savings. Capture the value BEFORE release() drops it (the non-streaming path
+            # releases in a finally that runs before this dict is built).
+            cached = fe.cached.get(rid, 0) if cached_tokens is None else cached_tokens
+            return {
+                "prompt_tokens": prompt_len,
+                "completion_tokens": detok.num_tokens,
+                "total_tokens": prompt_len + detok.num_tokens,
+                "prompt_tokens_details": {"cached_tokens": cached},
+            }
+
+        if body.get("stream"):
+
+            async def sse():
+                done = False
+                gate = _ToolCallGate(fe.tool_calls_marker)
+                finish_reason = "stop"
+                try:
+                    yield chunk({"role": "assistant", "content": ""})
+                    async for text, finish in tokens():
+                        if finish is not None:
+                            finish_reason = finish
+                        out = gate.feed(text)
+                        if out:
+                            yield chunk({"content": out})
+                    done = True
+                    tail = gate.flush()
+                    if tail:
+                        yield chunk({"content": tail})
+                    tool_calls: list[dict] = []
+                    if gate.gated:
+                        _, tool_calls = fe.split_tool_calls(gate.block)
+                        if not tool_calls:
+                            # Truncated or malformed block: surface it verbatim instead of dropping it.
+                            yield chunk({"content": gate.block})
+                    for index, call in enumerate(tool_calls):
+                        # Name first, then arguments: what OpenAI clients (and new-api) accumulate.
+                        yield chunk({
+                            "tool_calls": [{
+                                "index": index,
+                                "id": call["id"],
+                                "type": "function",
+                                "function": {"name": call["function"]["name"], "arguments": ""},
+                            }]
+                        })
+                        yield chunk({
+                            "tool_calls": [{"index": index, "function": {"arguments": call["function"]["arguments"]}}]
+                        })
+                    if tool_calls:
+                        finish_reason = "tool_calls"
+                    # finish_reason gets its own chunk now: with tool calls it must come after the deltas.
+                    yield chunk({}, finish_reason)
+                    if include_usage or fe.args.always_usage:
+                        # `--always-usage`: gateways that never send include_usage still need the numbers,
+                        # otherwise they count tokens locally and cache hits always read as zero.
+                        yield chunk({}, usage=usage())
+                    yield "data: [DONE]\n\n"
+                finally:
+                    fe.release(rid, aborted=not done)
+
+            return StreamingResponse(sse(), media_type="text/event-stream")
+
+        done = False
+        try:
+            parts, finish = [], None
+            async for text, finish in tokens():  # noqa: B007  (the last finish reason is reported below)
+                parts.append(text)
+            done = True
+            cached_tokens = fe.cached.get(rid, 0)  # must be read before release() pops it
+        finally:
+            fe.release(rid, aborted=not done)
+        content, tool_calls = fe.split_tool_calls("".join(parts))
+        message: dict = {"role": "assistant", "content": content}
+        if tool_calls:
+            message["tool_calls"] = tool_calls
+            finish = "tool_calls"
+        return {
+            "id": cid,
+            "object": "chat.completion",
+            "created": created,
+            "model": fe.model_name,
+            "choices": [{"index": 0, "message": message, "finish_reason": finish}],
+            "usage": usage(cached_tokens),
+        }
+
+    @app.post("/v1/messages")
+    async def messages(request: Request):
+        """Anthropic Messages API: same engine, recipe's Messages conversion and event stream."""
+        if fe.protocol_layer != "recipe":
+            return JSONResponse(
+                {"error": {"message": "the Messages API needs --protocol-layer recipe"}}, status_code=501
+            )
+        return await recipe_response(fe, "messages", await request.json())
+
+    @app.post("/anthropic/v1/messages")
+    async def anthropic_messages(request: Request):
+        """DeepSeek's Anthropic base_url convention: `.../anthropic` + the SDK's own `/v1/messages`."""
+        return await messages(request)
+
+    @app.post("/v1/messages/count_tokens")
+    async def messages_count_tokens(request: Request):
+        """Anthropic's token-counting endpoint: the client sizes its context window from this."""
+        if fe.protocol_layer != "recipe":
+            return JSONResponse(
+                {"error": {"message": "count_tokens needs --protocol-layer recipe"}}, status_code=501
+            )
+        return await count_tokens_response(fe, await request.json())
+
+    @app.post("/anthropic/v1/messages/count_tokens")
+    async def anthropic_messages_count_tokens(request: Request):
+        return await messages_count_tokens(request)
+
+    @app.post("/v1/responses")
+    async def responses(request: Request):
+        """OpenAI Responses API: same engine, recipe's Responses conversion and event stream."""
+        if fe.protocol_layer != "recipe":
+            return JSONResponse(
+                {"error": {"message": "the Responses API needs --protocol-layer recipe"}}, status_code=501
+            )
+        return await recipe_response(fe, "responses", await request.json())
+
+    return app
+
+
+def main() -> None:
+    args = parse_args()
+    args.model = str(Path(args.model).expanduser().resolve())
+    os.environ.setdefault("WORLD_SIZE", "1")
+    os.environ.setdefault("RANK", "0")
+    fe = Frontend(args)
+    fe.start()
+
+    import uvicorn
+
+    uvicorn.run(build_app(fe), host=args.host, port=args.port, log_level="warning", timeout_keep_alive=900)
+
+
+if __name__ == "__main__":
+    main()
