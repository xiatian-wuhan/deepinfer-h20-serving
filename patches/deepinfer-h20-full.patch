+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("copy_pages", &copy_pages, py::arg("src_base"), py::arg("dst_base"), py::arg("src_ids"), py::arg("dst_ids"),
+        py::arg("page_bytes"),
