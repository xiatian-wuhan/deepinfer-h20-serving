diff --git a/deepinfer/model_executor/parallel_utils/engram_nvlink.py b/deepinfer/model_executor/parallel_utils/engram_nvlink.py
new file mode 100644
index 0000000..6b6600a
--- /dev/null
+++ b/deepinfer/model_executor/parallel_utils/engram_nvlink.py
@@ -0,0 +1,144 @@
+"""Single-node Engram fetch over NCCL collectives (NVLink), for machines without NCCL GIN.
+
+Drop-in for the `deep_ep.EngramBuffer` subset used by `EngramRuntime` (write / fetch / destroy).
+Each rank keeps its table shard (pinned host memory unless DEEPINFER_ENGRAM_FORCE_GPU_STORAGE) and the
+full FP8 scaling-factor table on GPU. A fetch all-gathers the indices, every rank looks up the rows it
+owns, and one all_to_all returns them.
+
+The collective buffers keep the engine-wide capacity `max_num_tokens` as their token dimension: the
+shapes must match on every rank of the group, and data-parallel replicas run independent batches, so a
+smaller per-step shape cannot be agreed on without a host sync (illegal inside a CUDA graph).
+What *was* wasted is gone: the first version gathered the rows into a temporary, copied it into the send
+buffer and then masked it, so a decode step moved 3 GB of rows three times over. The row gather now
+writes the send buffer directly (`out=`) and the masking is dropped - the receiver only ever reads the
+chunk of the rank that owns a row, so the other slots are dead bytes.
+See notes/15-profiler-engram-breakdown.md and notes/17-engram-fetch-fix.md.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+import torch
+import torch.distributed as dist
+
+from deepinfer import envs
+
+_NUM_ALIGNED_SF_PACKS = 4  # DeepEP kNumAlignedSFPacks = 16 / sizeof(int32)
+
+
+def _uva_view(t: torch.Tensor) -> torch.Tensor:
+    """CUDA-tagged view of a pinned host tensor (zero-copy reads over PCIe)."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    storage = torch._C._construct_storage_from_data_pointer(t.data_ptr(), device, t.nbytes)
+    return torch.empty(0, dtype=t.dtype, device=device).set_(storage, 0, t.shape, t.stride())
+
+
+class NVLinkEngramBuffer:
+    def __init__(
+        self,
+        group: dist.ProcessGroup,
+        num_entries_per_layer: list[int],
+        hidden: int,
+        max_num_tokens: int,
+        num_entries_per_token: int,
+        dtype: torch.dtype,
+        num_sf_packs: int = 0,
+    ) -> None:
+        self.group = group
+        self.rank, self.world_size = group.rank(), group.size()
+        self.num_entries_per_layer = num_entries_per_layer
+        self.hidden = hidden
+        self.max_num_tokens = max_num_tokens
+        self.num_entries_per_token = num_entries_per_token
+        self.dtype = dtype
+        self.num_sf_packs = num_sf_packs
+
+        self._num_layers = len(num_entries_per_layer)
+        self._row_bytes = hidden * dtype.itemsize
+        # Keyed by cap: at most two entries, the decode capacity and the prefill capacity.
+        self._bufs: dict[int, tuple[torch.Tensor, torch.Tensor, torch.Tensor]] = {}
+        self._storages: list[torch.Tensor] = []  # keeps the host shards alive
+        self._tables: list[torch.Tensor] = []  # CUDA views used for lookup
+        self._sfs: list[torch.Tensor] | None = None
+
+    def write(self, storages: list[torch.Tensor], sfs: list[torch.Tensor] | None = None) -> None:
+        assert len(storages) == len(self.num_entries_per_layer)
+        for storage, num_entries in zip(storages, self.num_entries_per_layer, strict=True):
+            assert storage.shape == (num_entries, self.hidden) and storage.dtype == self.dtype, (storage.shape, storage.dtype)
+            if envs.DEEPINFER_ENGRAM_FORCE_GPU_STORAGE:
+                storage = storage.to("cuda", non_blocking=True)
+            elif storage.device.type == "cpu" and not storage.is_pinned():
+                storage = storage.pin_memory()
+            self._storages.append(storage)
+            self._tables.append(_uva_view(storage) if storage.device.type == "cpu" else storage)
+        if sfs is not None:
+            self._sfs = [sf.cuda() for sf in sfs]
+        dist.barrier(group=self.group)
+
+    def _buffers(self, cap: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Collective buffers for `cap` tokens per rank.
+
+        `cap` is an engine-wide constant (never the per-step count), so the shapes are identical on every rank
+        without a host sync and stay fixed inside a CUDA graph.
+        """
+        bufs = self._bufs.get(cap)
+        if bufs is None:
+            world, layers, entries = self.world_size, self._num_layers, self.num_entries_per_token
+            gathered = torch.empty((world, layers, cap, entries), dtype=torch.int32, device="cuda")
+            # Layer-major so that `send[layer]` is contiguous: the row gather writes it through `out=`.
+            send = torch.empty((layers, world, cap, entries, self._row_bytes), dtype=torch.uint8, device="cuda")
+            bufs = (gathered, send, torch.empty_like(send))
+            self._bufs[cap] = bufs
+        return bufs
+
+    def fetch(self, indices: torch.Tensor, num_qps: int = 0, use_tma_aligned_col_major_sf: bool = True) -> list[Callable]:
+        num_layers, num_tokens, num_entries_per_token = indices.shape
+        assert num_tokens <= self.max_num_tokens and num_entries_per_token == self.num_entries_per_token
+        # NOTE: `cap` must not depend on the step's own load. Data-parallel replicas run independent batches,
+        # so one replica can be prefilling while another decodes; a load-dependent cap makes the two sides
+        # call all_gather with different shapes and NCCL waits forever. A per-phase cap would also work, but
+        # only where every rank in the group provably runs the same batch (cp > 1, dp == 1).
+        cap = self.max_num_tokens
+        gathered_indices, send_buf, recv_buf = self._buffers(cap)
+
+        if cap == num_tokens:
+            gathered_in = indices.contiguous()
+        else:
+            gathered_in = indices.new_full((num_layers, cap, num_entries_per_token), -1)
+            gathered_in[:, :num_tokens] = indices
+        dist.all_gather_into_tensor(gathered_indices, gathered_in, group=self.group)
+
+        # Look up the rows this rank owns and write them straight into the outgoing chunk. Rows owned
+        # elsewhere keep whatever the previous step left there; the receiver only ever reads the chunk of
+        # the rank that does own a row (`owner` below), so those slots are dead bytes and need no masking.
+        for layer_idx, (table, num_entries) in enumerate(zip(self._tables, self.num_entries_per_layer, strict=True)):
+            local_idx = gathered_indices[:, layer_idx] - self.rank * num_entries
+            owned = (local_idx >= 0) & (local_idx < num_entries)
+            flat_idx = torch.where(owned, local_idx, 0).flatten()
+            send = send_buf[layer_idx]
+            torch.index_select(table.view(torch.uint8), 0, flat_idx, out=send.view(-1, self._row_bytes))
+            dist.all_to_all_single(recv_buf[layer_idx], send, group=self.group)
+
+        token_idx = torch.arange(num_tokens, device=indices.device).unsqueeze(-1)
+        entry_idx = torch.arange(num_entries_per_token, device=indices.device)
+        hooks = []
+        for layer_idx, num_entries in enumerate(self.num_entries_per_layer):
+            owner = (indices[layer_idx] // num_entries).long()
+            fetched = recv_buf[layer_idx][owner, token_idx, entry_idx]  # [T, E, row_bytes]
+            fetched = fetched.view(self.dtype).reshape(num_tokens, num_entries_per_token * self.hidden)
+            if self._sfs is None:
+                hooks.append(lambda fetched=fetched: fetched)
+                continue
+            sf = self._sfs[layer_idx][indices[layer_idx].long()].reshape(num_tokens, -1)  # [T, E * packs]
+            if use_tma_aligned_col_major_sf:
+                aligned = (num_tokens + _NUM_ALIGNED_SF_PACKS - 1) // _NUM_ALIGNED_SF_PACKS * _NUM_ALIGNED_SF_PACKS
+                sf = sf.new_empty(sf.size(1) * aligned).as_strided(sf.shape, (1, aligned)).copy_(sf)
+            hooks.append(lambda fetched=fetched, sf=sf: (fetched, sf))
+        return hooks
+
+    def destroy(self) -> None:
+        self._storages.clear()
+        self._tables.clear()
+        self._sfs = None
+        self._bufs.clear()
